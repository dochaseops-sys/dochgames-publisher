  file_change {
    absolute_path_uri: "file:///src/components/publisher/WidgetBuilderPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "    <div className=\"space-y-6\">\n      {/* Top Header */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 bg-[#071B4B] border border-slate-800 rounded-2xl p-6 shadow-xl\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-[#129BFF]/20 text-[#11D9FF] border border-[#129BFF]/30\">\n              WIDGET STUDIO v1.4\n            </span>\n            <span className=\"text-xs text-slate-400\">\302\267 Property: {selectedProperty?.name}</span>\n          </div>\n          <h1 className=\"font-display font-bold text-2xl text-white\">\n            Interactive Widget Creator & Syndication Engine\n          </h1>\n          <p className=\"text-xs text-slate-400 mt-1\">\n            Build high-engagement instant browser game reels and seamlessly syndicate them to your host properties.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={() => setActiveStage(7)}\n            className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#040f2b] border border-slate-700 text-xs font-semibold text-slate-200 hover:border-[#129BFF] hover:text-white transition-colors\"\n          >\n            <Eye className=\"w-4 h-4 text-[#11D9FF]\" />\n            Full Context Preview\n          </button>\n          <button\n            onClick={handlePublish}\n            className=\"flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#129BFF] to-[#7B2CF5] text-white text-xs font-bold shadow-lg hover:opacity-95 transition-opacity\"\n          >\n            <Sparkles className=\"w-4 h-4\" />\n            Publish Widget\n          </button>\n        </div>\n      </div>\n\n      {/* Stepper Navigation Progress Bar */}\n      <div className=\"bg-[#071B4B] border border-slate-800 rounded-2xl p-3 shadow-lg overflow-x-auto\">\n        <div className=\"flex items-center justify-between min-w-max gap-2 px-2\">\n          {stages.map((st) => (\n            <button\n              key={st.num}\n              onClick={() => setActiveStage(st.num)}\n              className={`flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-medium transition-all ${\n                activeStage === st.num\n                  ? \'bg-[#129BFF] text-white shadow-md\'\n                  : activeStage > st.num\n                  ? \'text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/40\'\n              }`}\n            >\n              <span className={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${\n                activeStage === st.num\n                  ? \'bg-white text-[#129BFF]\'\n                  : activeStage > st.num\n                  ? \'bg-emerald-500 text-slate-950\'\n                  : \'bg-slate-800 text-slate-400\'\n              }`}>\n                {activeStage > st.num ? <Check className=\"w-3 h-3\" /> : st.num}\n              </span>\n              <span>{st.title}</span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Main Content Area */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Controls Column (7 cols) */}\n        <div className=\"lg:col-span-7 bg-[#071B4B] border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6\">"
      replacement_content: "    <div className=\"space-y-6 max-w-[1520px] mx-auto\">\n      {/* Top Header */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white border border-slate-100 rounded-3xl p-7 shadow-xs\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-50 text-blue-600 border border-blue-100\">\n              WIDGET STUDIO v1.4\n            </span>\n            <span className=\"text-xs text-slate-500\">\302\267 Property: <strong className=\"text-slate-800\">{selectedProperty?.name}</strong></span>\n          </div>\n          <h1 className=\"text-2xl font-extrabold text-slate-900 tracking-tight\">\n            Interactive Widget Creator & Syndication Engine\n          </h1>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            Build high-engagement instant browser game reels and seamlessly syndicate them to your host properties.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={() => setActiveStage(7)}\n            className=\"flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition-colors\"\n          >\n            <Eye className=\"w-4 h-4 text-blue-600\" />\n            Full Context Preview\n          </button>\n          <button\n            onClick={handlePublish}\n            className=\"flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold shadow-xs transition-opacity\"\n          >\n            <Sparkles className=\"w-4 h-4\" />\n            Publish Widget\n          </button>\n        </div>\n      </div>\n\n      {/* Stepper Navigation Progress Bar */}\n      <div className=\"bg-white border border-slate-100 rounded-3xl p-3 shadow-xs overflow-x-auto\">\n        <div className=\"flex items-center justify-between min-w-max gap-2 px-2\">\n          {stages.map((st) => (\n            <button\n              key={st.num}\n              onClick={() => setActiveStage(st.num)}\n              className={`flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-medium transition-all ${\n                activeStage === st.num\n                  ? \'bg-[#D4F826] text-slate-950 font-bold shadow-2xs\'\n                  : activeStage > st.num\n                  ? \'text-emerald-700 bg-emerald-50 hover:bg-emerald-100\'\n                  : \'text-slate-500 hover:text-slate-900 hover:bg-slate-50\'\n              }`}\n            >\n              <span className={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${\n                activeStage === st.num\n                  ? \'bg-slate-900 text-white\'\n                  : activeStage > st.num\n                  ? \'bg-emerald-600 text-white\'\n                  : \'bg-slate-200 text-slate-600\'\n              }`}>\n                {activeStage > st.num ? <Check className=\"w-3 h-3\" /> : st.num}\n              </span>\n              <span>{st.title}</span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Main Content Area */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Controls Column (7 cols) */}\n        <div className=\"lg:col-span-7 bg-white border border-slate-100 rounded-3xl p-7 shadow-xs space-y-6\">"
