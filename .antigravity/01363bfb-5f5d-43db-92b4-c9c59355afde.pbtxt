      target_content: "  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"bg-[#071B4B] border border-[#129BFF]/30 p-6 rounded-2xl shadow-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"p-1 rounded bg-[#7B2CF5]/20 text-[#D82CF4]\">\n              <Gamepad2 className=\"w-4 h-4\" />\n            </span>\n            <span className=\"text-xs text-[#11D9FF] font-semibold uppercase tracking-wider\">\n              Game Developer Portal\n            </span>\n          </div>\n          <h2 className=\"font-display text-2xl font-bold text-white\">\n            Submit Game for Global Syndication\n          </h2>\n          <p className=\"text-slate-300 text-xs mt-1\">\n            Complete the 6-step submission with automated pre-flight validation and sandbox container testing.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={onCancel}\n            className=\"px-4 py-2 rounded-xl bg-[#040f2b] border border-slate-700 text-slate-300 text-xs hover:text-white\"\n          >\n            Cancel\n          </button>\n          <button\n            onClick={() => setTestPlayModalOpen(true)}\n            className=\"flex items-center gap-1.5 px-4 py-2 rounded-xl bg-[#129BFF]/20 border border-[#129BFF]/40 text-[#11D9FF] text-xs font-semibold hover:bg-[#129BFF]/30 transition-colors\"\n          >\n            <Play className=\"w-3.5 h-3.5 fill-current\" />\n            Test in Sandbox\n          </button>\n        </div>\n      </div>\n\n      {/* Stepper Tabs */}\n      <div className=\"bg-[#071B4B] border border-slate-800 rounded-xl p-3 overflow-x-auto shadow-sm\">\n        <div className=\"flex items-center gap-2 min-w-max\">\n          {steps.map(s => (\n            <button\n              key={s.num}\n              onClick={() => setActiveStep(s.num)}\n              className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${\n                activeStep === s.num\n                  ? \'bg-[#129BFF] text-white shadow-sm\'\n                  : s.num < activeStep\n                  ? \'bg-slate-800/80 text-emerald-400\'\n                  : \'text-slate-400 hover:text-white hover:bg-slate-800/40\'\n              }`}\n            >\n              <span className={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${\n                activeStep === s.num ? \'bg-white text-[#129BFF]\' : \'bg-[#040f2b] text-slate-300\'\n              }`}>\n                {s.num}\n              </span>\n              <span>{s.title}</span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Form Content Area */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        <div className=\"lg:col-span-8 bg-[#071B4B] border border-slate-800 rounded-2xl p-6 shadow-xl space-y-5\">"
      replacement_content: "  return (\n    <div className=\"space-y-6 max-w-[1520px] mx-auto\">\n      {/* Header */}\n      <div className=\"bg-white border border-slate-100 p-7 rounded-3xl shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"text-[11px] font-bold text-blue-600 uppercase tracking-wider bg-blue-50 px-2.5 py-0.5 rounded-full\">\n              Developer Pipeline\n            </span>\n            <span className=\"text-slate-400\">\302\267</span>\n            <span className=\"text-xs text-slate-500\">Global Syndication</span>\n          </div>\n          <h2 className=\"text-2xl font-extrabold text-slate-900 tracking-tight\">\n            Submit Game for Global Syndication\n          </h2>\n          <p className=\"text-slate-500 text-xs mt-1\">\n            Complete the 6-step submission with automated pre-flight validation and sandbox container testing.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={onCancel}\n            className=\"px-4 py-2 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold hover:bg-slate-200\"\n          >\n            Cancel\n          </button>\n          <button\n            onClick={() => setTestPlayModalOpen(true)}\n            className=\"flex items-center gap-1.5 px-5 py-2.5 rounded-full bg-blue-50 text-blue-600 text-xs font-bold hover:bg-blue-100 transition-colors\"\n          >\n            <Play className=\"w-3.5 h-3.5 fill-current\" />\n            Test in Sandbox\n          </button>\n        </div>\n      </div>\n\n      {/* Stepper Tabs */}\n      <div className=\"bg-white border border-slate-100 rounded-3xl p-3 overflow-x-auto shadow-xs\">\n        <div className=\"flex items-center gap-2 min-w-max\">\n          {steps.map(s => (\n            <button\n              key={s.num}\n              onClick={() => setActiveStep(s.num)}\n              className={`flex items-center gap-2 px-3.5 py-2 rounded-full text-xs font-medium transition-all ${\n                activeStep === s.num\n                  ? \'bg-[#D4F826] text-slate-950 font-bold shadow-2xs\'\n                  : s.num < activeStep\n                  ? \'bg-emerald-50 text-emerald-700\'\n                  : \'text-slate-500 hover:text-slate-900 hover:bg-slate-50\'\n              }`}\n            >\n              <span className={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${\n                activeStep === s.num ? \'bg-slate-900 text-white\' : s.num < activeStep ? \'bg-emerald-600 text-white\' : \'bg-slate-200 text-slate-600\'\n              }`}>\n                {s.num}\n              </span>\n              <span>{s.title}</span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Form Content Area */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        <div className=\"lg:col-span-8 bg-white border border-slate-100 rounded-3xl p-7 shadow-xs space-y-6\">"
