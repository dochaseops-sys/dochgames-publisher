        target_content: "        {/* Right Sticky Preview Column (5 cols) */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <div className=\"sticky top-6 space-y-4\">\n            <div className=\"bg-[#071B4B] border border-slate-800 rounded-2xl p-4 shadow-xl\">\n              {/* Header with Mode Switcher */}\n              <div className=\"flex items-center justify-between pb-3 mb-3 border-b border-slate-700/60\">\n                <div className=\"flex items-center gap-1.5\">\n                  <Eye className=\"w-4 h-4 text-[#11D9FF]\" />\n                  <span className=\"text-xs font-semibold text-slate-200\">\n                    Live Widget Preview\n                  </span>\n                </div>\n\n                {/* View Mode Toggle */}\n                {hasScreenshot ? (\n                  <div className=\"flex items-center gap-1 bg-[#040f2b] p-0.5 rounded-lg border border-slate-700\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewMode(\'screenshot\')}\n                      className={`px-2 py-0.5 rounded text-[10px] font-semibold transition-colors flex items-center gap-1 ${\n                        previewMode === \'screenshot\' \n                          ? \'bg-[#129BFF] text-white\' \n                          : \'text-slate-400 hover:text-white\'\n                      }`}\n                    >\n                      <ImageIcon className=\"w-3 h-3\" />\n                      On Site\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewMode(\'standalone\')}\n                      className={`px-2 py-0.5 rounded text-[10px] font-semibold transition-colors flex items-center gap-1 ${\n                        previewMode === \'standalone\' \n                          ? \'bg-[#129BFF] text-white\' \n                          : \'text-slate-400 hover:text-white\'\n                      }`}\n                    >\n                      <Layers className=\"w-3 h-3\" />\n                      Widget Only\n                    </button>\n                  </div>\n                ) : (\n                  <span className=\"text-[10px] text-emerald-400 font-mono\">STANDALONE CANVAS</span>\n                )}\n              </div>"
        replacement_content: "        {/* Right Sticky Preview Column (5 cols) */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <div className=\"sticky top-24 space-y-4\">\n            <div className=\"bg-white border border-slate-100 rounded-3xl p-5 shadow-xs\">\n              {/* Header with Mode Switcher */}\n              <div className=\"flex items-center justify-between pb-3 mb-3 border-b border-slate-100\">\n                <div className=\"flex items-center gap-1.5\">\n                  <Eye className=\"w-4 h-4 text-blue-600\" />\n                  <span className=\"text-xs font-bold text-slate-800\">\n                    Live Widget Preview\n                  </span>\n                </div>\n\n                {/* View Mode Toggle */}\n                {hasScreenshot ? (\n                  <div className=\"flex items-center gap-1 bg-slate-100 p-0.5 rounded-full border border-slate-200\">\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewMode(\'screenshot\')}\n                      className={`px-2.5 py-1 rounded-full text-[10px] font-bold transition-colors flex items-center gap-1 ${\n                        previewMode === \'screenshot\' \n                          ? \'bg-[#2563EB] text-white shadow-2xs\' \n                          : \'text-slate-500 hover:text-slate-900\'\n                      }`}\n                    >\n                      <ImageIcon className=\"w-3 h-3\" />\n                      On Site\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => setPreviewMode(\'standalone\')}\n                      className={`px-2.5 py-1 rounded-full text-[10px] font-bold transition-colors flex items-center gap-1 ${\n                        previewMode === \'standalone\' \n                          ? \'bg-[#2563EB] text-white shadow-2xs\' \n                          : \'text-slate-500 hover:text-slate-900\'\n                      }`}\n                    >\n                      <Layers className=\"w-3 h-3\" />\n                      Widget Only\n                    </button>\n                  </div>\n                ) : (\n                  <span className=\"text-[10px] text-emerald-600 font-bold bg-emerald-50 px-2.5 py-0.5 rounded-full\">STANDALONE CANVAS</span>\n                )}\n              </div>"
