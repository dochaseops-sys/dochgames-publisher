  file_change {
    absolute_path_uri: "file:///src/components/publisher/ConnectPropertyModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  X, Globe, Key, CheckCircle, ShieldCheck, Copy, \n  ExternalLink, ArrowRight, RefreshCw, AlertCircle \n} from \'lucide-react\';\nimport { PublisherProperty } from \'../../types\';\n\ninterface ConnectPropertyModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onPropertyCreated: (property: PublisherProperty) => void;\n}\n\nexport const ConnectPropertyModal: React.FC<ConnectPropertyModalProps> = ({\n  isOpen,\n  onClose,\n  onPropertyCreated\n}) => {\n  const [step, setStep] = useState<1 | 2 | 3>(1);\n  const [siteName, setSiteName] = useState<string>(\'\');\n  const [domain, setDomain] = useState<string>(\'\');\n  const [verificationMethod, setVerificationMethod] = useState<\'dns_txt\' | \'meta_tag\'>(\'dns_txt\');\n  const [isVerifying, setIsVerifying] = useState<boolean>(false);\n  const [verificationError, setVerificationError] = useState<string | null>(null);\n  const [generatedProperty, setGeneratedProperty] = useState<PublisherProperty | null>(null);\n  const [copiedKey, setCopiedKey] = useState<boolean>(false);\n\n  if (!isOpen) return null;\n\n  const handleStartVerification = () => {\n    if (!siteName.trim() || !domain.trim()) {\n      setVerificationError(\'Please enter both your property name and root domain.\');\n      return;\n    }\n\n    setVerificationError(null);\n    const cleanDomain = domain.replace(/^https?:\\/\\//, \'\').replace(/\\/.*$/, \'\').trim();\n    const token = `doch-verify=${Math.random().toString(36).substring(2, 10)}-${Date.now().toString(36)}`;\n    const pubKey = `pub_live_${Math.random().toString(36).substring(2, 8)}_${Math.random().toString(36).substring(2, 10)}`;\n\n    const newProp: PublisherProperty = {\n      id: `prop-${Date.now()}`,\n      name: siteName,\n      domain: cleanDomain,\n      verified: false,\n      verificationMethod,\n      verificationToken: token,\n      allowedOrigins: [`https://${cleanDomain}`, `https://www.${cleanDomain}`],\n      publisherKey: pubKey,\n      createdAt: new Date().toISOString(),\n      totalWidgets: 0\n    };\n\n    setGeneratedProperty(newProp);\n    setStep(2);\n  };\n\n  const handleConfirmVerification = () => {\n    if (!generatedProperty) return;\n    setIsVerifying(true);\n    setVerificationError(null);\n\n    // Simulate instant DNS / Meta tag lookup check\n    setTimeout(() => {\n      setIsVerifying(false);\n      const verifiedProp: PublisherProperty = {\n        ...generatedProperty,\n        verified: true\n      };\n      setGeneratedProperty(verifiedProp);\n      onPropertyCreated(verifiedProp);\n      setStep(3);\n    }, 1200);\n  };\n\n  const copyToClipboard = (text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedKey(true);\n    setTimeout(() => setCopiedKey(false), 2000);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in\">\n      <div className=\"bg-white border border-slate-100 rounded-3xl shadow-2xl w-full max-w-xl overflow-hidden flex flex-col\">\n        {/* Header */}\n        <div className=\"px-6 py-5 border-b border-slate-100 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center\">\n              <Globe className=\"w-5 h-5 text-[#2563EB]\" />\n            </div>\n            <div>\n              <h3 className=\"font-bold text-base text-slate-900\">\n                Connect Site or App\n              </h3>\n              <p className=\"text-xs text-slate-500\">\n                Step {step} of 3 \302\267 Automated property registration & credential issue\n              </p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Body content */}\n        <div className=\"p-6 space-y-5\">\n          {step === 1 && (\n            <div className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">\n                  Property or App Name\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Apex Gaming Portal\"\n                  value={siteName}\n                  onChange={(e) => setSiteName(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">\n                  Website URL / Host Domain\n                </label>\n                <div className=\"relative\">\n                  <span className=\"absolute left-3.5 top-2.5 text-xs text-slate-400\">https://</span>\n                  <input\n                    type=\"text\"\n                    placeholder=\"apexgaming.com\"\n                    value={domain}\n                    onChange={(e) => setDomain(e.target.value)}\n                    className=\"w-full bg-slate-50 border border-slate-200 rounded-xl pl-18 pr-4 py-2.5 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">\n                  Ownership Verification Method\n                </label>\n                <div className=\"grid grid-cols-2 gap-3\">\n                  <div\n                    onClick={() => setVerificationMethod(\'dns_txt\')}\n                    className={`p-3.5 rounded-2xl border cursor-pointer transition-all ${\n                      verificationMethod === \'dns_txt\'\n                        ? \'bg-blue-50/80 border-blue-500 ring-2 ring-blue-500/20 text-slate-900\'\n                        : \'bg-slate-50 border-slate-200 text-slate-600 hover:bg-slate-100\'\n                    }`}\n                  >\n                    <div className=\"font-bold text-xs mb-0.5 text-slate-900\">DNS TXT Record</div>\n                    <div className=\"text-[11px] text-slate-500\">Add TXT entry to your domain DNS</div>\n                  </div>\n\n                  <div\n                    onClick={() => setVerificationMethod(\'meta_tag\')}\n                    className={`p-3.5 rounded-2xl border cursor-pointer transition-all ${\n                      verificationMethod === \'meta_tag\'\n                        ? \'bg-blue-50/80 border-blue-500 ring-2 ring-blue-500/20 text-slate-900\'\n                        : \'bg-slate-50 border-slate-200 text-slate-600 hover:bg-slate-100\'\n                    }`}\n                  >\n                    <div className=\"font-bold text-xs mb-0.5 text-slate-900\">HTML Meta Tag</div>\n                    <div className=\"text-[11px] text-slate-500\">Insert tag into HTML &lt;head&gt;</div>\n                  </div>\n                </div>\n              </div>\n\n              {verificationError && (\n                <div className=\"flex items-center gap-2 p-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs\">\n                  <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                  <span>{verificationError}</span>\n                </div>\n              )}\n\n              <div className=\"pt-2 flex justify-end\">\n                <button\n                  onClick={handleStartVerification}\n                  className=\"flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold shadow-xs transition-all\"\n                >\n                  Continue to Verification\n                  <ArrowRight className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n          )}\n\n          {step === 2 && generatedProperty && (\n            <div className=\"space-y-4\">\n              <div className=\"bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-2\">\n                <div className=\"text-xs font-bold text-slate-700\">\n                  {verificationMethod === \'dns_txt\' \n                    ? \'1. Add this DNS TXT record to your registrar\' \n                    : \'1. Paste this meta tag into your homepage <head>\'}\n                </div>\n\n                <div className=\"flex items-center justify-between bg-white p-3 rounded-xl border border-slate-200 font-mono text-xs text-blue-600 break-all\">\n                  <span>\n                    {verificationMethod === \'dns_txt\' \n                      ? generatedProperty.verificationToken \n                      : `<meta name=\"dochgames-site-verification\" content=\"${generatedProperty.verificationToken}\" />`}\n                  </span>\n                  <button\n                    onClick={() => copyToClipboard(\n                      verificationMethod === \'dns_txt\' \n                        ? generatedProperty.verificationToken \n                        : `<meta name=\"dochgames-site-verification\" content=\"${generatedProperty.verificationToken}\" />`\n                    )}\n                    className=\"p-1.5 rounded-lg text-slate-400 hover:text-slate-600 shrink-0 ml-2\"\n                    title=\"Copy token\"\n                  >\n                    <Copy className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"text-xs text-slate-500 leading-relaxed\">\n                Once added, click <strong>Verify Domain Ownership</strong>. DochGames will test the DNS/HTML handshake and issue your permanent Publisher Key.\n              </div>\n\n              <div className=\"pt-2 flex items-center justify-between\">\n                <button\n                  onClick={() => setStep(1)}\n                  className=\"text-xs font-semibold text-slate-500 hover:text-slate-900\"\n                >\n                  Back\n                </button>\n                <button\n                  onClick={handleConfirmVerification}\n                  disabled={isVerifying}\n                  className=\"flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold shadow-xs transition-all disabled:opacity-50\"\n                >\n                  {isVerifying ? (\n                    <>\n                      <RefreshCw className=\"w-4 h-4 animate-spin\" />\n                      Checking Records...\n                    </>\n                  ) : (\n                    <>\n                      <ShieldCheck className=\"w-4 h-4\" />\n                      Verify Domain Ownership\n                    </>\n                  )}\n                </button>\n              </div>\n            </div>\n          )}\n\n          {step === 3 && generatedProperty && (\n            <div className=\"space-y-5 text-center py-2\">\n              <div className=\"w-14 h-14 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto\">\n                <CheckCircle className=\"w-8 h-8\" />\n              </div>\n\n              <div>\n                <h4 className=\"text-lg font-bold text-slate-900 mb-1\">\n                  Property Verified Successfully!\n                </h4>\n                <p className=\"text-xs text-slate-500\">\n                  {generatedProperty.name} ({generatedProperty.domain}) is registered and authorized.\n                </p>\n              </div>\n\n              {/* Publisher Key Display */}\n              <div className=\"bg-slate-50 p-4 rounded-2xl border border-slate-200 text-left space-y-2\">\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-xs font-bold text-slate-700 flex items-center gap-1.5\">\n                    <Key className=\"w-3.5 h-3.5 text-blue-600\" />\n                    Generated Publisher Key\n                  </span>\n                  <span className=\"text-[10px] text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded-full\">STATUS: ACTIVE</span>\n                </div>\n\n                <div className=\"flex items-center justify-between bg-white p-3 rounded-xl border border-slate-200 font-mono text-xs text-slate-800\">\n                  <span>{generatedProperty.publisherKey}</span>\n                  <button\n                    onClick={() => copyToClipboard(generatedProperty.publisherKey)}\n                    className=\"flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-bold hover:bg-slate-200 transition-colors\"\n                  >\n                    <Copy className=\"w-3.5 h-3.5\" />\n                    {copiedKey ? \'Copied!\' : \'Copy\'}\n                  </button>\n                </div>\n                <p className=\"text-[11px] text-slate-500\">\n                  All widgets created for this property will automatically inherit this key for monetization attribution.\n                </p>\n              </div>\n\n              <div className=\"pt-2\">\n                <button\n                  onClick={onClose}\n                  className=\"w-full py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold shadow-xs transition-all\"\n                >\n                  Done & Go to Widget Builder\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
