  file_change {
    absolute_path_uri: "file:///src/components/publisher/MyWidgetsPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Plus, Edit3, Copy, Trash2, Play, Pause, Code, \n  ExternalLink, Sparkles, Filter, CheckCircle, Eye, AlertCircle, X\n} from \'lucide-react\';\nimport { WidgetConfig, GameItem, PublisherProperty } from \'../../types\';\nimport { DochWidgetRenderer } from \'../widgets/DochWidgetRenderer\';\n\ninterface MyWidgetsPageProps {\n  widgets: WidgetConfig[];\n  properties: PublisherProperty[];\n  games: GameItem[];\n  onCreateNew: () => void;\n  onEditWidget: (widget: WidgetConfig) => void;\n  onDuplicateWidget: (widget: WidgetConfig) => void;\n  onToggleStatus: (widgetId: string) => void;\n  onDeleteWidget: (widgetId: string) => void;\n  onPlayGame: (game: GameItem) => void;\n}\n\nexport const MyWidgetsPage: React.FC<MyWidgetsPageProps> = ({\n  widgets,\n  properties,\n  games,\n  onCreateNew,\n  onEditWidget,\n  onDuplicateWidget,\n  onToggleStatus,\n  onDeleteWidget,\n  onPlayGame\n}) => {\n  const [filterProperty, setFilterProperty] = useState<string>(\'all\');\n  const [previewWidget, setPreviewWidget] = useState<WidgetConfig | null>(null);\n  const [activeCodeModalWidget, setActiveCodeModalWidget] = useState<WidgetConfig | null>(null);\n  const [copiedCode, setCopiedCode] = useState<boolean>(false);\n\n  const filteredWidgets = widgets.filter(w => {\n    if (filterProperty === \'all\') return true;\n    return w.propertyId === filterProperty;\n  });\n\n  const getEmbedCode = (w: WidgetConfig) => {\n    const prop = properties.find(p => p.id === w.propertyId);\n    const pubKey = prop?.publisherKey || \'pub_live_xxxxxxxx\';\n    return `<script \n  src=\"https://cdn.dochgames.com/v1/widget.js\" \n  data-publisher=\"${pubKey}\" \n  data-widget=\"${w.id}\" \n  async>\n</script>\n<div id=\"dochgames-widget-${w.id}\"></div>`;\n  };\n\n  const handleCopyCode = (w: WidgetConfig) => {\n    navigator.clipboard.writeText(getEmbedCode(w));\n    setCopiedCode(true);\n    setTimeout(() => setCopiedCode(false), 2000);\n  };\n\n  return (\n    <div className=\"space-y-6 max-w-[1520px] mx-auto\">\n      {/* Top Banner */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white border border-slate-100 p-7 rounded-3xl shadow-xs\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"text-[11px] font-bold text-blue-600 uppercase tracking-wider bg-blue-50 px-2.5 py-0.5 rounded-full\">\n              Distribution Units\n            </span>\n            <span className=\"text-slate-400\">\302\267</span>\n            <span className=\"text-xs text-slate-500\">{widgets.length} Total Units</span>\n          </div>\n          <h2 className=\"text-2xl font-extrabold text-slate-900 tracking-tight\">\n            Syndicated Content & Smart Widgets\n          </h2>\n          <p className=\"text-slate-500 text-xs mt-1\">\n            Manage your live embedded game reels, placement slots, and real-time CTR analytics.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <select\n            value={filterProperty}\n            onChange={(e) => setFilterProperty(e.target.value)}\n            className=\"bg-slate-50 border border-slate-200 rounded-full px-4 py-2 text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n          >\n            <option value=\"all\">All Properties ({widgets.length})</option>\n            {properties.map(p => (\n              <option key={p.id} value={p.id}>{p.name}</option>\n            ))}\n          </select>\n\n          <button\n            onClick={onCreateNew}\n            className=\"flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold transition-all shadow-xs\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            Build New Widget\n          </button>\n        </div>\n      </div>\n\n      {/* Widgets Table / Cards */}\n      <div className=\"space-y-4\">\n        {filteredWidgets.length === 0 ? (\n          <div className=\"p-12 text-center bg-white border border-slate-100 rounded-3xl shadow-xs\">\n            <h4 className=\"text-lg font-bold text-slate-900 mb-2\">No widgets found</h4>\n            <p className=\"text-slate-500 text-xs mb-4\">You have not created any widgets for this property yet.</p>\n            <button\n              onClick={onCreateNew}\n              className=\"px-5 py-2 rounded-full bg-[#2563EB] text-white text-xs font-bold hover:bg-[#1D4ED8]\"\n            >\n              Build Your First Widget\n            </button>\n          </div>\n        ) : (\n          filteredWidgets.map(widget => (\n            <div\n              key={widget.id}\n              className=\"bg-white border border-slate-100 hover:border-slate-200 hover:shadow-md rounded-3xl p-6 shadow-xs transition-all duration-150 flex flex-col lg:flex-row lg:items-center justify-between gap-5\"\n            >\n              <div className=\"space-y-2 flex-1\">\n                <div className=\"flex items-center gap-2.5 flex-wrap\">\n                  <h3 className=\"font-bold text-base text-slate-900\">\n                    {widget.name}\n                  </h3>\n                  <span className={`text-[11px] font-bold px-2.5 py-0.5 rounded-full ${\n                    widget.status === \'published\' \n                      ? \'bg-emerald-50 text-emerald-600\' \n                      : \'bg-amber-50 text-amber-600\'\n                  }`}>\n                    {widget.status.toUpperCase()}\n                  </span>\n                  <span className=\"text-xs text-slate-400\">\302\267</span>\n                  <span className=\"text-xs text-slate-500 font-mono\">v{widget.version}</span>\n                  {widget.version > (widget.publishedVersion || 1) && (\n                    <span className=\"text-[10px] text-amber-700 font-bold bg-amber-50 px-2 py-0.5 rounded-full\">\n                      Unpublished Draft Edits\n                    </span>\n                  )}\n                </div>\n\n                <div className=\"flex items-center gap-3 text-xs text-slate-500 flex-wrap\">\n                  <span>Property: <strong className=\"text-slate-800\">{widget.propertyName}</strong></span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>Placement: <strong className=\"text-blue-600 uppercase font-semibold\">{widget.placement}</strong></span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>Layout: <strong>{widget.layout.replace(\'_\', \' \')}</strong></span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>Games: <strong>{widget.gameCount}</strong></span>\n                </div>\n\n                {/* Metrics row */}\n                <div className=\"flex items-center gap-5 pt-1 text-xs\">\n                  <div className=\"text-slate-500\">\n                    Impressions: <strong className=\"text-slate-900 font-bold tabular-nums\">{widget.stats.impressions.toLocaleString()}</strong>\n                  </div>\n                  <div className=\"text-slate-500\">\n                    Game Starts: <strong className=\"text-blue-600 font-bold tabular-nums\">{widget.stats.gameStarts.toLocaleString()}</strong>\n                  </div>\n                  <div className=\"text-slate-500\">\n                    CTR: <strong className=\"text-emerald-600 font-bold tabular-nums\">{widget.stats.ctr}%</strong>\n                  </div>\n                </div>\n              </div>\n\n              {/* Actions */}\n              <div className=\"flex items-center gap-2 self-end lg:self-center shrink-0\">\n                <button\n                  onClick={() => setPreviewWidget(widget)}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition-colors\"\n                >\n                  <Eye className=\"w-3.5 h-3.5 text-blue-600\" />\n                  Preview\n                </button>\n\n                <button\n                  onClick={() => setActiveCodeModalWidget(widget)}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-100 transition-colors\"\n                >\n                  <Code className=\"w-3.5 h-3.5 text-blue-600\" />\n                  Get Code\n                </button>\n\n                <button\n                  onClick={() => onEditWidget(widget)}\n                  className=\"p-2 rounded-full bg-slate-50 border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors\"\n                  title=\"Edit Widget\"\n                >\n                  <Edit3 className=\"w-3.5 h-3.5\" />\n                </button>\n\n                <button\n                  onClick={() => onDuplicateWidget(widget)}\n                  className=\"p-2 rounded-full bg-slate-50 border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors\"\n                  title=\"Duplicate Widget\"\n                >\n                  <Copy className=\"w-3.5 h-3.5\" />\n                </button>\n\n                <button\n                  onClick={() => onToggleStatus(widget.id)}\n                  className={`p-2 rounded-full border transition-colors ${\n                    widget.status === \'published\'\n                      ? \'bg-amber-50 border-amber-200 text-amber-600 hover:bg-amber-100\'\n                      : \'bg-emerald-50 border-emerald-200 text-emerald-600 hover:bg-emerald-100\'\n                  }`}\n                  title={widget.status === \'published\' ? \'Pause Widget\' : \'Activate Widget\'}\n                >\n                  {widget.status === \'published\' ? <Pause className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3.5 h-3.5\" />}\n                </button>\n\n                <button\n                  onClick={() => onDeleteWidget(widget.id)}\n                  className=\"p-2 rounded-full text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors\"\n                  title=\"Delete Widget\"\n                >\n                  <Trash2 className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n\n      {/* Standalone Preview Modal */}\n      {previewWidget && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in\">\n          <div className=\"bg-white rounded-3xl shadow-2xl border border-slate-100 w-full max-w-3xl overflow-hidden p-6 space-y-4\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <h3 className=\"font-bold text-base text-slate-900\">\n                {previewWidget.name} (Live Interactive Preview)\n              </h3>\n              <button\n                onClick={() => setPreviewWidget(null)}\n                className=\"p-2 text-slate-400 hover:text-slate-600 rounded-full hover:bg-slate-100\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"p-4 bg-slate-50 rounded-2xl border border-slate-200/60\">\n              <DochWidgetRenderer \n                config={previewWidget} \n                games={games} \n                onPlayGame={onPlayGame} \n              />\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Code Snippet Modal */}\n      {activeCodeModalWidget && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in\">\n          <div className=\"bg-white rounded-3xl shadow-2xl border border-slate-100 w-full max-w-xl overflow-hidden p-6 space-y-4\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <h3 className=\"font-bold text-base text-slate-900\">\n                Integration Embed Snippet\n              </h3>\n              <button\n                onClick={() => setActiveCodeModalWidget(null)}\n                className=\"p-2 text-slate-400 hover:text-slate-600 rounded-full hover:bg-slate-100\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <p className=\"text-xs text-slate-500\">\n              Insert this script into your HTML page where you want the widget to appear:\n            </p>\n\n            <pre className=\"p-4 bg-slate-900 border border-slate-800 rounded-2xl text-xs font-mono text-emerald-400 overflow-x-auto\">\n              {getEmbedCode(activeCodeModalWidget)}\n            </pre>\n\n            <div className=\"flex justify-end gap-3 pt-2\">\n              <button\n                onClick={() => handleCopyCode(activeCodeModalWidget)}\n                className=\"px-5 py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold transition-all shadow-xs\"\n              >\n                {copiedCode ? \'Copied to Clipboard!\' : \'Copy Code Snippet\'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
    diff {
