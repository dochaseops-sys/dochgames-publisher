  file_change {
    absolute_path_uri: "file:///src/components/widgets/LiveSitePlacementMock.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  Monitor, Tablet, Smartphone, ExternalLink, RefreshCw, \n  Layers, Check, Sparkles, AlertCircle, Image as ImageIcon \n} from \'lucide-react\';\nimport { WidgetConfig, GameItem } from \'../../types\';\nimport { DochWidgetRenderer } from \'./DochWidgetRenderer\';\n\ninterface LiveSitePlacementMockProps {\n  config: WidgetConfig;\n  games: GameItem[];\n  onPlayGame: (game: GameItem) => void;\n}\n\nexport const LiveSitePlacementMock: React.FC<LiveSitePlacementMockProps> = ({\n  config,\n  games,\n  onPlayGame\n}) => {\n  const [device, setDevice] = useState<\'desktop\' | \'tablet\' | \'mobile\'>(\'desktop\');\n  const [hostTemplate, setHostTemplate] = useState<string>(\n    config.customScreenshotUrl ? \'uploaded_screenshot\' : \'gaming_news\'\n  );\n  const [customUrl, setCustomUrl] = useState<string>(\n    config.targetPageUrl || \'https://gamezone-daily.com/articles/cyberpunk-future\'\n  );\n\n  useEffect(() => {\n    if (config.customScreenshotUrl && hostTemplate !== \'uploaded_screenshot\') {\n      setHostTemplate(\'uploaded_screenshot\');\n    }\n  }, [config.customScreenshotUrl]);\n\n  const getContainerWidth = () => {\n    switch (device) {\n      case \'mobile\':\n        return \'max-w-[390px]\';\n      case \'tablet\':\n        return \'max-w-[768px]\';\n      default:\n        return \'max-w-full\';\n    }\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Viewport & Simulation Toolbar */}\n      <div className=\"bg-white border border-slate-100 rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3 text-xs shadow-xs\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-slate-500 font-semibold\">Placement:</span>\n          <span className=\"px-3 py-1 rounded-full bg-blue-50 text-blue-700 font-bold uppercase text-[11px]\">\n            {config.placement.replace(\'_\', \' \')}\n          </span>\n        </div>\n\n        {/* Device Switcher */}\n        <div className=\"flex items-center gap-1 bg-slate-50 p-1 rounded-full border border-slate-200\">\n          <button\n            onClick={() => setDevice(\'desktop\')}\n            className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-full transition-all ${\n              device === \'desktop\' ? \'bg-[#2563EB] text-white font-bold shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Monitor className=\"w-3.5 h-3.5\" />\n            <span>Desktop</span>\n          </button>\n          <button\n            onClick={() => setDevice(\'tablet\')}\n            className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-full transition-all ${\n              device === \'tablet\' ? \'bg-[#2563EB] text-white font-bold shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Tablet className=\"w-3.5 h-3.5\" />\n            <span>Tablet</span>\n          </button>\n          <button\n            onClick={() => setDevice(\'mobile\')}\n            className={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-full transition-all ${\n              device === \'mobile\' ? \'bg-[#2563EB] text-white font-bold shadow-xs\' : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Smartphone className=\"w-3.5 h-3.5\" />\n            <span>Mobile</span>\n          </button>\n        </div>\n\n        {/* Host Template Selection */}\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-slate-500 font-semibold\">Host Template:</span>\n          <select\n            value={hostTemplate}\n            onChange={(e) => setHostTemplate(e.target.value)}\n            className=\"bg-slate-50 border border-slate-200 rounded-full px-3.5 py-1.5 text-slate-800 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500\"\n          >\n            {config.customScreenshotUrl && (\n              <option value=\"uploaded_screenshot\">\n                \360\237\223\270 {config.customScreenshotName || \'Uploaded Site Screenshot\'}\n              </option>\n            )}\n            <option value=\"gaming_news\">GameZone Daily (Media/Reviews)</option>\n            <option value=\"tech_magazine\">TechPulse Digital (Tech News)</option>\n            <option value=\"sports_portal\">Apex Sports Arena (Editorial)</option>\n          </select>\n        </div>\n      </div>\n\n      {/* Simulated Browser Window Frame */}\n      <div className=\"bg-white border border-slate-200 rounded-3xl shadow-xl overflow-hidden flex flex-col items-center\">\n        {/* Browser Top Nav / Address bar */}\n        <div className=\"w-full bg-slate-50 px-5 py-3 border-b border-slate-200 flex items-center gap-3\">\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-red-400 inline-block\"></span>\n            <span className=\"w-2.5 h-2.5 rounded-full bg-amber-400 inline-block\"></span>\n            <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block\"></span>\n          </div>\n          <div className=\"flex-1 max-w-lg mx-auto bg-white border border-slate-200 rounded-full px-4 py-1 text-xs text-slate-600 flex items-center justify-between shadow-2xs\">\n            <span className=\"truncate\">{customUrl}</span>\n            <span className=\"text-[10px] text-emerald-600 font-bold ml-2\">\360\237\224\222 HTTPS OK</span>\n          </div>\n          <div className=\"text-[11px] text-slate-400 font-mono\">\n            {device.toUpperCase()} MODE\n          </div>\n        </div>\n\n        {/* Responsive Content Stage */}\n        <div className=\"w-full bg-slate-100/60 p-4 sm:p-6 flex justify-center min-h-[640px] overflow-x-auto\">\n          {/* 1. Uploaded Screenshot Host Environment */}\n          {hostTemplate === \'uploaded_screenshot\' && config.customScreenshotUrl ? (\n            <div className={`w-full ${getContainerWidth()} rounded-2xl shadow-xl overflow-hidden border border-slate-300 relative bg-slate-900 flex flex-col transition-all duration-300`}>\n              {/* Screenshot as background with live widget positioned */}\n              <div className=\"relative min-h-[700px] w-full bg-slate-950 overflow-hidden flex flex-col\">\n                {/* Background Screenshot Image */}\n                <img\n                  src={config.customScreenshotUrl}\n                  alt=\"Uploaded Site Screenshot\"\n                  className=\"w-full h-auto object-cover opacity-90 block\"\n                />\n                \n                {/* Overlay layer with injected widget according to placement */}\n                <div className=\"absolute inset-0 flex flex-col justify-between pointer-events-none p-4 sm:p-6\">\n                  {/* Top / Header Placement */}\n                  {config.placement === \'header\' && (\n                    <div className=\"pointer-events-auto bg-white/95 backdrop-blur-md p-3.5 rounded-2xl border border-blue-400 shadow-2xl animate-in fade-in w-full\">\n                      <div className=\"text-[10px] uppercase font-bold text-blue-600 mb-2 flex items-center justify-between\">\n                        <span className=\"flex items-center gap-1.5\">\n                          <Sparkles className=\"w-3 h-3 text-blue-600\" />\n                          Injected Live Widget [Header Placement]\n                        </span>\n                        <span className=\"font-mono text-slate-500 text-[9px] bg-slate-100 px-2 py-0.5 rounded-full\">\n                          {config.appearance.sizePreset || \'Fluid Width\'}\n                        </span>\n                      </div>\n                      <DochWidgetRenderer config={config} games={games} onPlayGame={onPlayGame} />\n                    </div>\n                  )}\n\n                  {/* In-Content Placement (Centered) */}\n                  {config.placement === \'in_content\' && (\n                    <div className=\"my-auto pointer-events-auto bg-white/95 backdrop-blur-md p-3.5 rounded-2xl border border-blue-400 shadow-2xl animate-in fade-in w-full max-w-4xl mx-auto\">\n                      <div className=\"text-[10px] uppercase font-bold text-blue-600 mb-2 flex items-center justify-between\">\n                        <span className=\"flex items-center gap-1.5\">\n                          <Sparkles className=\"w-3 h-3 text-blue-600\" />\n                          Injected Live Widget [In-Content Editorial Slot]\n                        </span>\n                        <span className=\"font-mono text-slate-500 text-[9px] bg-slate-100 px-2 py-0.5 rounded-full\">\n                          {config.appearance.sizePreset || \'Fluid Width\'}\n                        </span>\n                      </div>\n                      <DochWidgetRenderer config={config} games={games} onPlayGame={onPlayGame} />\n                    </div>\n                  )}\n\n                  {/* Sidebar Placement (Right column overlay) */}\n                  {config.placement === \'sidebar\' && (\n                    <div className=\"my-auto ml-auto pointer-events-auto bg-white/95 backdrop-blur-md p-3.5 rounded-2xl border border-blue-400 shadow-2xl animate-in fade-in w-full max-w-sm\">\n                      <div className=\"text-[10px] uppercase font-bold text-blue-600 mb-2 flex items-center justify-between\">\n                        <span className=\"flex items-center gap-1.5\">\n                          <Sparkles className=\"w-3 h-3 text-blue-600\" />\n                          Injected Live Widget [Sidebar Rail]\n                        </span>\n                        <span className=\"font-mono text-slate-500 text-[9px] bg-slate-100 px-2 py-0.5 rounded-full\">\n                          Mini Rail\n                        </span>\n                      </div>\n                      <DochWidgetRenderer config={config} games={games} onPlayGame={onPlayGame} />\n                    </div>\n                  )}\n\n                  {/* Below Content / Footer Placement */}\n                  {(config.placement === \'below_content\' || config.placement === \'custom\') && (\n                    <div className=\"mt-auto pointer-events-auto bg-white/95 backdrop-blur-md p-3.5 rounded-2xl border border-blue-400 shadow-2xl animate-in fade-in w-full\">\n                      <div className=\"text-[10px] uppercase font-bold text-blue-600 mb-2 flex items-center justify-between\">\n                        <span className=\"flex items-center gap-1.5\">\n                          <Sparkles className=\"w-3 h-3 text-blue-600\" />\n                          Injected Live Widget [{config.placement === \'custom\' ? \'Custom DOM Container\' : \'Below Content / Recommendations\'}]\n                        </span>\n                        <span className=\"font-mono text-slate-500 text-[9px] bg-slate-100 px-2 py-0.5 rounded-full\">\n                          {config.appearance.sizePreset || \'Fluid Width\'}\n                        </span>\n                      </div>\n                      <DochWidgetRenderer config={config} games={games} onPlayGame={onPlayGame} />\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Footer info bar */}\n              <div className=\"bg-slate-900 border-t border-slate-800 px-4 py-2.5 text-xs text-slate-400 flex items-center justify-between\">\n                <span className=\"flex items-center gap-1.5 text-slate-200\">\n                  <ImageIcon className=\"w-3.5 h-3.5 text-blue-400\" />\n                  Displaying on uploaded host site screenshot\n                </span>\n                <span className=\"text-[11px] font-mono text-blue-400\">Interactive Preview</span>\n              </div>\n            </div>\n          ) : (\n            /* 2. Default Pre-built Mock Host Layout */\n            <div className={`w-full ${getContainerWidth()} bg-white text-slate-900 rounded-2xl shadow-xl overflow-hidden border border-slate-200 flex flex-col transition-all duration-300`}>\n              {/* Host Page Header */}\n              <div className=\"border-b border-slate-200 px-6 py-4 flex items-center justify-between bg-white\">\n                <div className=\"flex items-center gap-3\">\n                  <span className=\"font-extrabold text-lg tracking-tight text-slate-900\">\n                    {hostTemplate === \'gaming_news\' ? \'GAMEZONE DAILY\' : hostTemplate === \'tech_magazine\' ? \'TECHPULSE\' : \'APEX ARENA\'}\n                  </span>\n                  <span className=\"text-xs text-slate-400 hidden sm:inline\">NEWS \302\267 REVIEWS \302\267 ESPORTS</span>\n                </div>\n                <div className=\"text-xs font-bold text-blue-600 cursor-pointer\">\n                  Subscribe\n                </div>\n              </div>\n\n              {/* Injected Widget in HEADER placement */}\n              {config.placement === \'header\' && (\n                <div className=\"p-3 bg-slate-50 border-b border-blue-200 relative\">\n                  <div className=\"text-[10px] uppercase font-bold text-blue-600 mb-1 flex items-center gap-1\">\n                    <Sparkles className=\"w-3 h-3\" />\n                    Live Injected Placement Slot [Header]\n                  </div>\n                  <DochWidgetRenderer config={config} games={games} onPlayGame={onPlayGame} />\n                </div>\n              )}\n\n              {/* Host Page Body Content */}\n              <div className=\"p-6 flex-1 flex flex-col md:flex-row gap-6\">\n                {/* Left / Main Content Column */}\n                <div className=\"flex-1 space-y-4\">\n                  <div className=\"space-y-2\">\n                    <span className=\"text-xs font-bold text-blue-600 uppercase tracking-wider\">\n                      Exclusive Feature\n                    </span>\n                    <h1 className=\"text-2xl font-extrabold leading-tight text-slate-900\">\n                      The Next Evolution of Instant Browser Gaming & Syndication\n                    </h1>\n                    <p className=\"text-xs text-slate-500\">\n                      By Marcus Vance \302\267 Published Today \302\267 5 min read\n                    </p>\n                  </div>\n\n                  <div className=\"h-44 bg-slate-200 rounded-xl overflow-hidden relative\">\n                    <img\n                      src=\"https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1000&q=80\"\n                      alt=\"Article hero\"\n                      className=\"w-full h-full object-cover\"\n                    />\n                  </div>\n\n                  <p className=\"text-xs text-slate-700 leading-relaxed\">\n                    Web-based game syndication has unlocked unprecedented engagement for digital publishers. With zero install barriers and modern WebGL engines, audiences can explore frictionless entertainment right inside editorial articles.\n                  </p>\n\n                  {/* Injected Widget in IN_CONTENT placement */}\n                  {config.placement === \'in_content\' && (\n                    <div className=\"my-4 p-3 bg-blue-50/70 border border-blue-200 rounded-2xl relative\">\n                      <div className=\"text-[10px] uppercase font-bold text-blue-600 mb-1 flex items-center gap-1\">\n                        <Sparkles className=\"w-3 h-3\" />\n                        Live Injected Placement Slot [In-Content Editorial]\n                      </div>\n                      <DochWidgetRenderer config={config} games={games} onPlayGame={onPlayGame} />\n                    </div>\n                  )}\n\n                  <p className=\"text-xs text-slate-700 leading-relaxed\">\n                    Publishers benefit from elevated dwell times and organic session extensions, with zero latency degradation or heavy script footprint.\n                  </p>\n\n                  {/* Injected Widget in BELOW_CONTENT placement */}\n                  {(config.placement === \'below_content\' || config.placement === \'custom\') && (\n                    <div className=\"mt-6 p-3 bg-blue-50/70 border border-blue-200 rounded-2xl relative\">\n                      <div className=\"text-[10px] uppercase font-bold text-blue-600 mb-1 flex items-center gap-1\">\n                        <Sparkles className=\"w-3 h-3\" />\n                        Live Injected Placement Slot [Below Content / Recommendations]\n                      </div>\n                      <DochWidgetRenderer config={config} games={games} onPlayGame={onPlayGame} />\n                    </div>\n                  )}\n                </div>\n\n                {/* Sidebar Column (Desktop/Tablet) */}\n                {device !== \'mobile\' && (\n                  <div className=\"w-72 shrink-0 space-y-4\">\n                    {/* Injected Widget in SIDEBAR placement */}\n                    {config.placement === \'sidebar\' && (\n                      <div className=\"p-2.5 bg-blue-50 border border-blue-200 rounded-2xl\">\n                        <div className=\"text-[10px] uppercase font-bold text-blue-600 mb-1.5 flex items-center gap-1\">\n                          <Sparkles className=\"w-3 h-3\" />\n                          Injected [Sidebar Mini Reel]\n                        </div>\n                        <DochWidgetRenderer config={config} games={games} onPlayGame={onPlayGame} />\n                      </div>\n                    )}\n\n                    {/* Standard Host Sidebar Cards */}\n                    <div className=\"bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-2\">\n                      <h4 className=\"text-xs font-bold text-slate-800 uppercase\">Top Stories</h4>\n                      <ul className=\"text-xs text-slate-600 space-y-2\">\n                        <li className=\"hover:text-blue-600 cursor-pointer\">\302\267 Next-gen hardware architecture revealed</li>\n                        <li className=\"hover:text-blue-600 cursor-pointer\">\302\267 Indie game festival award finalists 2026</li>\n                        <li className=\"hover:text-blue-600 cursor-pointer\">\302\267 WebAssembly speeds reach desktop parity</li>\n                      </ul>\n                    </div>\n\n                    <div className=\"bg-slate-100 p-3 rounded-2xl border border-slate-200 text-center text-xs text-slate-400\">\n                      Host Ad Space 300x250\n                    </div>\n                  </div>\n                )}\n              </div>\n\n              {/* Host Page Footer */}\n              <div className=\"bg-slate-50 border-t border-slate-200 px-6 py-3 text-[11px] text-slate-500 flex items-center justify-between\">\n                <span>\302\251 2026 Host Publisher Network. All rights reserved.</span>\n                <span>Powered by DochGames Syndication Engine</span>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      end_line: 340
      unified_diff {
        lines {
          text: "import React, { useState, useEffect } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
