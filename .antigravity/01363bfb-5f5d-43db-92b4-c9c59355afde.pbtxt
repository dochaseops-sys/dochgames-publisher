  file_change {
    absolute_path_uri: "file:///src/components/layout/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Search, Bell, Settings, ChevronDown, Check, Globe, \n  Sparkles, Shield, User, ArrowUpRight, Plus, Gamepad2, X\n} from \'lucide-react\';\nimport { UserRole, UserProfile } from \'../../types\';\n\ninterface NavbarProps {\n  currentRole: UserRole;\n  currentView: string;\n  currentUser: UserProfile;\n  realtimeConnected?: boolean;\n  unreadNotificationsCount: number;\n  onOpenNotifications: () => void;\n  onSelectRole: (role: UserRole) => void;\n  onNavigate: (view: string) => void;\n  onOpenConnectModal: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  currentRole,\n  currentView,\n  currentUser,\n  unreadNotificationsCount,\n  onOpenNotifications,\n  onSelectRole,\n  onNavigate,\n  onOpenConnectModal\n}) => {\n  const [isSearchOpen, setIsSearchOpen] = useState(false);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [isProfileOpen, setIsProfileOpen] = useState(false);\n  const [isRoleDropdownOpen, setIsRoleDropdownOpen] = useState(false);\n\n  // Map view to high-level TrendTide-style nav tabs\n  const getPublisherTab = () => {\n    if (currentView === \'dashboard\') return \'dashboard\';\n    if (currentView === \'widget_builder\' || currentView === \'my_widgets\') return \'content\';\n    if (currentView === \'game_hub\') return \'finance\';\n    if (currentView === \'publisher_analytics\') return \'reports\';\n    return \'dashboard\';\n  };\n\n  const getDeveloperTab = () => {\n    if (currentView === \'dashboard\') return \'dashboard\';\n    if (currentView === \'submit_game\' || currentView === \'my_games\') return \'content\';\n    if (currentView === \'studio_profile\') return \'finance\';\n    return \'dashboard\';\n  };\n\n  return (\n    <>\n      <header className=\"sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/80 shadow-xs\">\n        <div className=\"w-full max-w-[1520px] mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"flex items-center justify-between h-20\">\n            \n            {/* Left: Brand Logo & Wordmark matching TrendTide style */}\n            <div className=\"flex items-center gap-4 sm:gap-6\">\n              <div \n                onClick={() => onNavigate(\'dashboard\')}\n                className=\"flex items-center gap-2.5 cursor-pointer group select-none\"\n              >\n                {/* Geometric modern brand knot icon matching the reference blue symbol */}\n                <div className=\"relative w-9 h-9 flex items-center justify-center text-blue-600 transition-transform group-hover:scale-105\">\n                  <svg \n                    viewBox=\"0 0 36 36\" \n                    fill=\"none\" \n                    xmlns=\"http://www.w3.org/2000/svg\" \n                    className=\"w-9 h-9 text-[#2563EB]\"\n                  >\n                    <path \n                      d=\"M13.5 3C10.5 3 8 5.5 8 8.5C8 10.8 9.5 12.8 11.6 13.5C10.8 14.5 10.3 15.7 10.3 17C10.3 18.3 10.8 19.5 11.6 20.5C9.5 21.2 8 23.2 8 25.5C8 28.5 10.5 31 13.5 31C15.8 31 17.8 29.5 18.5 27.4C19.5 28.2 20.7 28.7 22 28.7C23.3 28.7 24.5 28.2 25.5 27.4C26.2 29.5 28.2 31 30.5 31C33.5 31 36 28.5 36 25.5C36 23.2 34.5 21.2 32.4 20.5C33.2 19.5 33.7 18.3 33.7 17C33.7 15.7 33.2 14.5 32.4 13.5C34.5 12.8 36 10.8 36 8.5C36 5.5 33.5 3 30.5 3C28.2 3 26.2 4.5 25.5 6.6C24.5 5.8 23.3 5.3 22 5.3C20.7 5.3 19.5 5.8 18.5 6.6C17.8 4.5 15.8 3 13.5 3Z\" \n                      fill=\"currentColor\"\n                      fillOpacity=\"0.12\"\n                    />\n                    <path \n                      d=\"M14 6C11.8 6 10 7.8 10 10C10 11.8 11.2 13.4 12.9 13.9C13.8 11.8 15.8 10.2 18.2 10.1C17.4 7.7 15.8 6 14 6Z\" \n                      fill=\"currentColor\"\n                    />\n                    <path \n                      d=\"M22 6C20.2 6 18.6 7.7 17.8 10.1C20.2 10.2 22.2 11.8 23.1 13.9C24.8 13.4 26 11.8 26 10C26 7.8 24.2 6 22 6Z\" \n                      fill=\"currentColor\"\n                    />\n                    <path \n                      d=\"M10 26C10 28.2 11.8 30 14 30C15.8 30 17.4 28.3 18.2 25.9C15.8 25.8 13.8 24.2 12.9 22.1C11.2 22.6 10 24.2 10 26Z\" \n                      fill=\"currentColor\"\n                    />\n                    <path \n                      d=\"M26 26C26 24.2 24.8 22.6 23.1 22.1C22.2 24.2 20.2 25.8 17.8 25.9C18.6 28.3 20.2 30 22 30C24.2 30 26 28.2 26 26Z\" \n                      fill=\"currentColor\"\n                    />\n                    <circle cx=\"18\" cy=\"18\" r=\"4.5\" fill=\"currentColor\" />\n                  </svg>\n                </div>\n                <div className=\"flex items-center\">\n                  <span className=\"font-extrabold text-2xl text-slate-900 tracking-tight\">\n                    Trend<span className=\"text-[#2563EB]\">Tide</span>\n                  </span>\n                  <span className=\"ml-2 hidden xl:inline-block text-[11px] font-bold text-slate-500 uppercase tracking-wider bg-slate-100 px-2 py-0.5 rounded-md border border-slate-200/60\">\n                    DochGames\n                  </span>\n                </div>\n              </div>\n\n              {/* Role Switcher Pill */}\n              <div className=\"relative\">\n                <button\n                  onClick={() => setIsRoleDropdownOpen(!isRoleDropdownOpen)}\n                  className=\"flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors border border-slate-200/80\"\n                >\n                  <span className=\"w-2 h-2 rounded-full bg-emerald-500\"></span>\n                  <span className=\"capitalize\">{currentRole}</span>\n                  <ChevronDown className=\"w-3 h-3 text-slate-400\" />\n                </button>\n\n                {isRoleDropdownOpen && (\n                  <div className=\"absolute left-0 mt-2 w-48 bg-white rounded-2xl shadow-xl border border-slate-100 py-1.5 z-50 animate-in fade-in zoom-in-95\">\n                    <div className=\"px-3 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider\">\n                      Switch Role\n                    </div>\n                    <button\n                      onClick={() => {\n                        onSelectRole(\'publisher\');\n                        setIsRoleDropdownOpen(false);\n                      }}\n                      className={`w-full flex items-center justify-between px-3 py-2 text-xs text-left ${\n                        currentRole === \'publisher\' ? \'bg-blue-50 text-blue-700 font-semibold\' : \'text-slate-700 hover:bg-slate-50\'\n                      }`}\n                    >\n                      <span>Publisher Portal</span>\n                      {currentRole === \'publisher\' && <Check className=\"w-3.5 h-3.5\" />}\n                    </button>\n                    <button\n                      onClick={() => {\n                        onSelectRole(\'developer\');\n                        setIsRoleDropdownOpen(false);\n                      }}\n                      className={`w-full flex items-center justify-between px-3 py-2 text-xs text-left ${\n                        currentRole === \'developer\' ? \'bg-blue-50 text-blue-700 font-semibold\' : \'text-slate-700 hover:bg-slate-50\'\n                      }`}\n                    >\n                      <span>Game Developer</span>\n                      {currentRole === \'developer\' && <Check className=\"w-3.5 h-3.5\" />}\n                    </button>\n                    <button\n                      onClick={() => {\n                        onSelectRole(\'admin\');\n                        setIsRoleDropdownOpen(false);\n                      }}\n                      className={`w-full flex items-center justify-between px-3 py-2 text-xs text-left ${\n                        currentRole === \'admin\' ? \'bg-blue-50 text-blue-700 font-semibold\' : \'text-slate-700 hover:bg-slate-50\'\n                      }`}\n                    >\n                      <span>QA Admin Console</span>\n                      {currentRole === \'admin\' && <Check className=\"w-3.5 h-3.5\" />}\n                    </button>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Center: The Iconic Segmented Nav Island (Exact look from the image) */}\n            <nav className=\"hidden md:flex items-center bg-slate-100/90 p-1.5 rounded-full border border-slate-200/70 shadow-2xs\">\n              {currentRole === \'publisher\' && (\n                <>\n                  <button\n                    onClick={() => onNavigate(\'dashboard\')}\n                    className={`px-5 py-2 rounded-full text-xs font-bold transition-all ${\n                      getPublisherTab() === \'dashboard\'\n                        ? \'bg-[#D4F826] text-slate-950 shadow-xs\'\n                        : \'text-slate-600 hover:text-slate-900 font-medium\'\n                    }`}\n                  >\n                    Dashboard\n                  </button>\n                  <button\n                    onClick={() => onNavigate(\'my_widgets\')}\n                    className={`px-5 py-2 rounded-full text-xs transition-all ${\n                      getPublisherTab() === \'content\'\n                        ? \'bg-[#D4F826] text-slate-950 font-bold shadow-xs\'\n                        : \'text-slate-600 hover:text-slate-900 font-medium\'\n                    }`}\n                  >\n                    Content\n                  </button>\n                  <button\n                    onClick={() => onNavigate(\'game_hub\')}\n                    className={`px-5 py-2 rounded-full text-xs transition-all ${\n                      getPublisherTab() === \'finance\'\n                        ? \'bg-[#D4F826] text-slate-950 font-bold shadow-xs\'\n                        : \'text-slate-600 hover:text-slate-900 font-medium\'\n                    }`}\n                  >\n                    Finance\n                  </button>\n                  <button\n                    onClick={() => onNavigate(\'publisher_analytics\')}\n                    className={`px-5 py-2 rounded-full text-xs transition-all ${\n                      getPublisherTab() === \'reports\'\n                        ? \'bg-[#D4F826] text-slate-950 font-bold shadow-xs\'\n                        : \'text-slate-600 hover:text-slate-900 font-medium\'\n                    }`}\n                  >\n                    Reports\n                  </button>\n                </>\n              )}\n\n              {currentRole === \'developer\' && (\n                <>\n                  <button\n                    onClick={() => onNavigate(\'dashboard\')}\n                    className={`px-5 py-2 rounded-full text-xs font-bold transition-all ${\n                      getDeveloperTab() === \'dashboard\'\n                        ? \'bg-[#D4F826] text-slate-950 shadow-xs\'\n                        : \'text-slate-600 hover:text-slate-900 font-medium\'\n                    }`}\n                  >\n                    Dashboard\n                  </button>\n                  <button\n                    onClick={() => onNavigate(\'my_games\')}\n                    className={`px-5 py-2 rounded-full text-xs transition-all ${\n                      getDeveloperTab() === \'content\'\n                        ? \'bg-[#D4F826] text-slate-950 font-bold shadow-xs\'\n                        : \'text-slate-600 hover:text-slate-900 font-medium\'\n                    }`}\n                  >\n                    Games\n                  </button>\n                  <button\n                    onClick={() => onNavigate(\'studio_profile\')}\n                    className={`px-5 py-2 rounded-full text-xs transition-all ${\n                      getDeveloperTab() === \'finance\'\n                        ? \'bg-[#D4F826] text-slate-950 font-bold shadow-xs\'\n                        : \'text-slate-600 hover:text-slate-900 font-medium\'\n                    }`}\n                  >\n                    Studio & Payouts\n                  </button>\n                </>\n              )}\n\n              {currentRole === \'admin\' && (\n                <button\n                  onClick={() => onNavigate(\'admin_console\')}\n                  className=\"px-5 py-2 rounded-full text-xs font-bold bg-[#D4F826] text-slate-950 shadow-xs\"\n                >\n                  Admin Operations\n                </button>\n              )}\n            </nav>\n\n            {/* Right: Round Icon Buttons + User Avatar */}\n            <div className=\"flex items-center gap-3\">\n              {/* Search Icon Button */}\n              <button\n                onClick={() => setIsSearchOpen(!isSearchOpen)}\n                className=\"w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 hover:text-slate-900 transition-colors border border-slate-200/60\"\n                title=\"Search properties, widgets & games\"\n                aria-label=\"Search\"\n              >\n                <Search className=\"w-4 h-4\" />\n              </button>\n\n              {/* Notification Bell Button with Active Indicator */}\n              <button\n                onClick={onOpenNotifications}\n                className=\"relative w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 hover:text-slate-900 transition-colors border border-slate-200/60\"\n                title=\"Notifications & System Audits\"\n                aria-label=\"Notifications\"\n              >\n                <Bell className=\"w-4 h-4\" />\n                {unreadNotificationsCount > 0 && (\n                  <span className=\"absolute 1.5 top-1.5 right-1.5 w-2.5 h-2.5 rounded-full bg-[#FF6B2C] ring-2 ring-white\"></span>\n                )}\n              </button>\n\n              {/* Settings Button */}\n              <button\n                onClick={() => {\n                  if (currentRole === \'publisher\') onOpenConnectModal();\n                  else if (currentRole === \'developer\') onNavigate(\'studio_profile\');\n                  else onNavigate(\'admin_console\');\n                }}\n                className=\"w-10 h-10 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600 hover:text-slate-900 transition-colors border border-slate-200/60\"\n                title=\"Settings & Configuration\"\n                aria-label=\"Settings\"\n              >\n                <Settings className=\"w-4 h-4\" />\n              </button>\n\n              {/* User Avatar Circle */}\n              <div className=\"relative\">\n                <button\n                  onClick={() => setIsProfileOpen(!isProfileOpen)}\n                  className=\"w-10 h-10 rounded-full overflow-hidden ring-2 ring-slate-200 hover:ring-[#2563EB] transition-all flex items-center justify-center bg-gradient-to-tr from-blue-600 to-indigo-600 text-white font-bold text-sm shadow-xs\"\n                >\n                  {/* Clean avatar initials or avatar presentation */}\n                  <span className=\"tracking-tight\">{currentUser.avatar || currentUser.name.slice(0, 2).toUpperCase()}</span>\n                </button>\n\n                {isProfileOpen && (\n                  <div className=\"absolute right-0 mt-2 w-64 bg-white rounded-2xl shadow-xl border border-slate-100 py-3 px-4 z-50 animate-in fade-in zoom-in-95\">\n                    <div className=\"flex items-center gap-3 pb-3 border-b border-slate-100\">\n                      <div className=\"w-10 h-10 rounded-full bg-[#2563EB] text-white flex items-center justify-center font-bold text-sm\">\n                        {currentUser.avatar || currentUser.name.slice(0, 2).toUpperCase()}\n                      </div>\n                      <div className=\"min-w-0\">\n                        <div className=\"font-bold text-sm text-slate-900 truncate\">{currentUser.name}</div>\n                        <div className=\"text-xs text-slate-500 truncate\">{currentUser.email}</div>\n                        <div className=\"text-[10px] font-semibold text-blue-600 uppercase mt-0.5\">{currentRole}</div>\n                      </div>\n                    </div>\n\n                    <div className=\"py-2 space-y-1\">\n                      {currentRole === \'publisher\' && (\n                        <button\n                          onClick={() => {\n                            onOpenConnectModal();\n                            setIsProfileOpen(false);\n                          }}\n                          className=\"w-full flex items-center gap-2 px-2.5 py-1.5 text-xs text-slate-700 hover:bg-slate-50 rounded-lg\"\n                        >\n                          <Globe className=\"w-3.5 h-3.5 text-blue-600\" />\n                          <span>Connect New Property</span>\n                        </button>\n                      )}\n                      <button\n                        onClick={() => {\n                          onOpenNotifications();\n                          setIsProfileOpen(false);\n                        }}\n                        className=\"w-full flex items-center justify-between px-2.5 py-1.5 text-xs text-slate-700 hover:bg-slate-50 rounded-lg\"\n                      >\n                        <div className=\"flex items-center gap-2\">\n                          <Bell className=\"w-3.5 h-3.5 text-slate-500\" />\n                          <span>Notifications</span>\n                        </div>\n                        {unreadNotificationsCount > 0 && (\n                          <span className=\"px-1.5 py-0.5 rounded-full text-[10px] bg-orange-100 text-orange-600 font-bold\">\n                            {unreadNotificationsCount}\n                          </span>\n                        )}\n                      </button>\n                    </div>\n                  </div>\n                )}\n              </div>\n            </div>\n\n          </div>\n\n          {/* Quick Search Overlay Drawer if opened */}\n          {isSearchOpen && (\n            <div className=\"pb-4 pt-1 flex items-center gap-2 animate-in fade-in slide-in-from-top-2\">\n              <div className=\"relative flex-1\">\n                <Search className=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400\" />\n                <input\n                  type=\"text\"\n                  value={searchQuery}\n                  onChange={(e) => setSearchQuery(e.target.value)}\n                  placeholder=\"Search live widgets, games, publisher domains, or analytics tags...\"\n                  className=\"w-full pl-10 pr-4 py-2 text-xs bg-slate-50 border border-slate-200 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500 text-slate-900 placeholder-slate-400\"\n                  autoFocus\n                />\n              </div>\n              <button\n                onClick={() => setIsSearchOpen(false)}\n                className=\"p-2 text-slate-400 hover:text-slate-600 rounded-full hover:bg-slate-100\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n          )}\n\n          {/* Mobile subnavigation pills */}\n          <div className=\"md:hidden flex items-center gap-1.5 overflow-x-auto py-2 border-t border-slate-100\">\n            {currentRole === \'publisher\' && (\n              <>\n                <button\n                  onClick={() => onNavigate(\'dashboard\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap ${\n                    currentView === \'dashboard\' ? \'bg-[#D4F826] text-slate-950\' : \'text-slate-600\'\n                  }`}\n                >\n                  Dashboard\n                </button>\n                <button\n                  onClick={() => onNavigate(\'my_widgets\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap ${\n                    currentView === \'my_widgets\' ? \'bg-[#D4F826] text-slate-950\' : \'text-slate-600\'\n                  }`}\n                >\n                  Content\n                </button>\n                <button\n                  onClick={() => onNavigate(\'game_hub\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap ${\n                    currentView === \'game_hub\' ? \'bg-[#D4F826] text-slate-950\' : \'text-slate-600\'\n                  }`}\n                >\n                  Finance\n                </button>\n                <button\n                  onClick={() => onNavigate(\'publisher_analytics\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap ${\n                    currentView === \'publisher_analytics\' ? \'bg-[#D4F826] text-slate-950\' : \'text-slate-600\'\n                  }`}\n                >\n                  Reports\n                </button>\n              </>\n            )}\n\n            {currentRole === \'developer\' && (\n              <>\n                <button\n                  onClick={() => onNavigate(\'dashboard\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap ${\n                    currentView === \'dashboard\' ? \'bg-[#D4F826] text-slate-950\' : \'text-slate-600\'\n                  }`}\n                >\n                  Dashboard\n                </button>\n                <button\n                  onClick={() => onNavigate(\'my_games\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap ${\n                    currentView === \'my_games\' ? \'bg-[#D4F826] text-slate-950\' : \'text-slate-600\'\n                  }`}\n                >\n                  Games\n                </button>\n                <button\n                  onClick={() => onNavigate(\'studio_profile\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap ${\n                    currentView === \'studio_profile\' ? \'bg-[#D4F826] text-slate-950\' : \'text-slate-600\'\n                  }`}\n                >\n                  Studio\n                </button>\n              </>\n            )}\n\n            {currentRole === \'admin\' && (\n              <button\n                onClick={() => onNavigate(\'admin_console\')}\n                className=\"px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap bg-[#D4F826] text-slate-950\"\n              >\n                QA Operations\n              </button>\n            )}\n          </div>\n\n        </div>\n      </header>\n    </>\n  );\n};\n"
