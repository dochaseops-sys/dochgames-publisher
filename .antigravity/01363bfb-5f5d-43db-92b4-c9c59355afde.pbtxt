    tool_summary: "Restyle PublisherAnalyticsPage to light SaaS theme"
    tool_action: "Updating PublisherAnalyticsPage"
    started_at {
      seconds: 1790180036
      nanos: 634919453
    }
  }
  file_change {
    absolute_path_uri: "file:///src/components/publisher/PublisherAnalyticsPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  BarChart3, TrendingUp, Users, DollarSign, Calendar, \n  Filter, Play, Smartphone, Monitor, Tablet, Info, ArrowUpRight, Download \n} from \'lucide-react\';\nimport { WidgetConfig, GameItem, PublisherProperty } from \'../../types\';\n\ninterface PublisherAnalyticsPageProps {\n  widgets: WidgetConfig[];\n  properties: PublisherProperty[];\n  games: GameItem[];\n}\n\nexport const PublisherAnalyticsPage: React.FC<PublisherAnalyticsPageProps> = ({\n  widgets,\n  properties,\n  games\n}) => {\n  const [timeRange, setTimeRange] = useState<\'7d\' | \'30d\' | \'90d\'>(\'30d\');\n  const [selectedPropertyId, setSelectedPropertyId] = useState<string>(\'all\');\n\n  const totalImpressions = widgets.reduce((acc, w) => acc + w.stats.impressions, 0);\n  const totalGameStarts = widgets.reduce((acc, w) => acc + w.stats.gameStarts, 0);\n  const avgCtr = widgets.length > 0 ? (widgets.reduce((acc, w) => acc + w.stats.ctr, 0) / widgets.length).toFixed(1) : \'0.0\';\n  const estimatedRevenue = (totalGameStarts * 0.042).toFixed(2);\n\n  // Daily trend data points for SVG chart\n  const dailyData = [\n    { day: \'Mon\', impressions: 42000, starts: 3100 },\n    { day: \'Tue\', impressions: 48000, starts: 3750 },\n    { day: \'Wed\', impressions: 55000, starts: 4200 },\n    { day: \'Thu\', impressions: 51000, starts: 3900 },\n    { day: \'Fri\', impressions: 64000, starts: 5100 },\n    { day: \'Sat\', impressions: 82000, starts: 6900 },\n    { day: \'Sun\', impressions: 76000, starts: 6300 }\n  ];\n\n  const maxImp = 90000;\n\n  return (\n    <div className=\"space-y-6 max-w-[1520px] mx-auto\">\n      {/* Top Filter Bar */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white border border-slate-100 p-7 rounded-3xl shadow-xs\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"text-[11px] font-bold text-blue-600 uppercase tracking-wider bg-blue-50 px-2.5 py-0.5 rounded-full\">\n              Intelligence & Performance\n            </span>\n            <span className=\"text-slate-400\">\302\267</span>\n            <span className=\"text-xs text-slate-500\">Live Attribution</span>\n          </div>\n          <h2 className=\"text-2xl font-extrabold text-slate-900 tracking-tight\">\n            Syndication & Audience Analytics\n          </h2>\n          <p className=\"text-slate-500 text-xs mt-0.5\">\n            Transparent attribution across smart widgets, branded hubs, and direct iframe endpoints.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <select\n            value={selectedPropertyId}\n            onChange={(e) => setSelectedPropertyId(e.target.value)}\n            className=\"bg-slate-50 border border-slate-200 rounded-full px-4 py-2 text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n          >\n            <option value=\"all\">All Properties</option>\n            {properties.map(p => (\n              <option key={p.id} value={p.id}>{p.name}</option>\n            ))}\n          </select>\n\n          {/* Time range buttons */}\n          <div className=\"flex items-center p-1 bg-slate-100 rounded-full border border-slate-200/80\">\n            {([\'7d\', \'30d\', \'90d\'] as const).map(tr => (\n              <button\n                key={tr}\n                onClick={() => setTimeRange(tr)}\n                className={`px-3.5 py-1 text-xs font-bold rounded-full transition-all ${\n                  timeRange === tr ? \'bg-[#D4F826] text-slate-950 shadow-2xs\' : \'text-slate-500 hover:text-slate-900\'\n                }`}\n              >\n                {tr.toUpperCase()}\n              </button>\n            ))}\n          </div>\n        </div>\n      </div>\n\n      {/* KPI Cards matching modern TrendTide styling */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n        <div className=\"bg-white border border-slate-100 rounded-3xl p-6 shadow-xs flex flex-col justify-between\">\n          <div>\n            <div className=\"w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-3\">\n              <Users className=\"w-5 h-5 text-[#2563EB]\" />\n            </div>\n            <div className=\"text-xs font-medium text-slate-500\">\n              Total Impressions\n            </div>\n            <div className=\"text-3xl font-extrabold text-slate-900 tracking-tight tabular-nums mt-1.5\">\n              {totalImpressions.toLocaleString()}\n            </div>\n          </div>\n          <div className=\"inline-flex items-center gap-1 text-xs font-bold text-emerald-600 mt-4 bg-emerald-50 px-2.5 py-0.5 rounded-full w-fit\">\n            <TrendingUp className=\"w-3.5 h-3.5\" /> +18.4% vs last period\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-slate-100 rounded-3xl p-6 shadow-xs flex flex-col justify-between\">\n          <div>\n            <div className=\"w-10 h-10 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center mb-3\">\n              <Play className=\"w-5 h-5 text-[#FF6B2C]\" />\n            </div>\n            <div className=\"text-xs font-medium text-slate-500\">\n              Game Starts (Plays)\n            </div>\n            <div className=\"text-3xl font-extrabold text-slate-900 tracking-tight tabular-nums mt-1.5\">\n              {totalGameStarts.toLocaleString()}\n            </div>\n          </div>\n          <div className=\"inline-flex items-center gap-1 text-xs font-bold text-emerald-600 mt-4 bg-emerald-50 px-2.5 py-0.5 rounded-full w-fit\">\n            <TrendingUp className=\"w-3.5 h-3.5\" /> +24.1% velocity\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-slate-100 rounded-3xl p-6 shadow-xs flex flex-col justify-between\">\n          <div>\n            <div className=\"w-10 h-10 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center mb-3\">\n              <BarChart3 className=\"w-5 h-5 text-purple-600\" />\n            </div>\n            <div className=\"text-xs font-medium text-slate-500\">\n              Average CTR\n            </div>\n            <div className=\"text-3xl font-extrabold text-slate-900 tracking-tight tabular-nums mt-1.5\">\n              {avgCtr}%\n            </div>\n          </div>\n          <div className=\"text-xs text-slate-400 mt-4\">\n            Benchmark: 3.2%\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-slate-100 rounded-3xl p-6 shadow-xs flex flex-col justify-between\">\n          <div>\n            <div className=\"w-10 h-10 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-3\">\n              <DollarSign className=\"w-5 h-5 text-amber-600\" />\n            </div>\n            <div className=\"text-xs font-medium text-slate-500\">\n              Estimated Ad Revenue\n            </div>\n            <div className=\"text-3xl font-extrabold text-slate-900 tracking-tight tabular-nums mt-1.5\">\n              ${estimatedRevenue}\n            </div>\n          </div>\n          <div className=\"text-xs text-slate-400 mt-4 flex items-center gap-1\">\n            <Info className=\"w-3 h-3 text-slate-400\" /> Net 85/15 rev-share\n          </div>\n        </div>\n      </div>\n\n      {/* Main Trends Chart & Breakdown */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Left Column: Interactive Trend Chart (2 cols) */}\n        <div className=\"lg:col-span-2 bg-white border border-slate-100 rounded-3xl p-7 shadow-xs space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900\">\n                Daily Game Starts & Impression Volume\n              </h3>\n              <p className=\"text-slate-500 text-xs\">Continuous 7-day roll with real-time attribution</p>\n            </div>\n            <div className=\"flex items-center gap-4 text-xs font-semibold\">\n              <span className=\"flex items-center gap-1.5 text-slate-600\">\n                <span className=\"w-3 h-3 rounded bg-slate-200 inline-block\"></span>\n                Impressions\n              </span>\n              <span className=\"flex items-center gap-1.5 text-slate-900\">\n                <span className=\"w-3 h-3 rounded bg-[#FF6B2C] inline-block\"></span>\n                Game Starts\n              </span>\n            </div>\n          </div>\n\n          {/* SVG Bar Chart with TrendTide styling */}\n          <div className=\"h-64 pt-6 flex items-end justify-between gap-4 border-b border-slate-100 pb-3\">\n            {dailyData.map((d, i) => {\n              const impHeight = (d.impressions / maxImp) * 100;\n              const startHeight = (d.starts / 8000) * 100;\n              return (\n                <div key={i} className=\"flex-1 flex flex-col items-center gap-1 group relative\">\n                  {/* Tooltip */}\n                  <div className=\"absolute -top-12 bg-slate-900 p-2 rounded-xl text-[10px] text-white opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-20 shadow-lg\">\n                    <div>{d.impressions.toLocaleString()} views</div>\n                    <div className=\"text-[#D4F826] font-bold\">{d.starts.toLocaleString()} starts</div>\n                  </div>\n\n                  <div className=\"w-full flex items-end justify-center gap-1.5 h-48\">\n                    {/* Impressions Bar */}\n                    <div \n                      className=\"w-1/2 bg-slate-100 group-hover:bg-slate-200 rounded-t-lg transition-all duration-300\"\n                      style={{ height: `${impHeight}%` }}\n                    />\n                    {/* Game Starts Bar */}\n                    <div \n                      className=\"w-1/2 bg-[#FF6B2C] group-hover:bg-[#fa5a1e] rounded-t-lg transition-all duration-300 shadow-2xs\"\n                      style={{ height: `${startHeight}%` }}\n                    />\n                  </div>\n                  <span className=\"text-xs text-slate-400 font-medium mt-2\">{d.day}</span>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Right Column: Device & Surface Distribution */}\n        <div className=\"bg-white border border-slate-100 rounded-3xl p-7 shadow-xs space-y-6\">\n          <h3 className=\"text-base font-bold text-slate-900\">\n            Device & Platform Split\n          </h3>\n\n          <div className=\"space-y-4 text-xs\">\n            <div>\n              <div className=\"flex items-center justify-between text-slate-600 mb-1.5 font-medium\">\n                <span className=\"flex items-center gap-2\">\n                  <Smartphone className=\"w-4 h-4 text-blue-600\" />\n                  Mobile Web (iOS & Android)\n                </span>\n                <span className=\"font-bold text-slate-900\">64%</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-[#2563EB] h-2 rounded-full\" style={{ width: \'64%\' }} />\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex items-center justify-between text-slate-600 mb-1.5 font-medium\">\n                <span className=\"flex items-center gap-2\">\n                  <Monitor className=\"w-4 h-4 text-indigo-600\" />\n                  Desktop Browsers\n                </span>\n                <span className=\"font-bold text-slate-900\">29%</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-indigo-600 h-2 rounded-full\" style={{ width: \'29%\' }} />\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex items-center justify-between text-slate-600 mb-1.5 font-medium\">\n                <span className=\"flex items-center gap-2\">\n                  <Tablet className=\"w-4 h-4 text-purple-600\" />\n                  Tablet & Foldables\n                </span>\n                <span className=\"font-bold text-slate-900\">7%</span>\n              </div>\n              <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                <div className=\"bg-purple-600 h-2 rounded-full\" style={{ width: \'7%\' }} />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-4 border-t border-slate-100\">\n            <h4 className=\"text-xs font-bold text-slate-800 mb-3\">Top Performing Titles</h4>\n            <div className=\"space-y-2 text-xs\">\n              {games.slice(0, 3).map((g) => (\n                <div key={g.id} className=\"flex items-center justify-between p-2.5 rounded-2xl bg-slate-50 border border-slate-100\">\n                  <span className=\"font-medium text-slate-800 truncate max-w-[140px]\">{g.title}</span>\n                  <span className=\"text-blue-600 font-bold tabular-nums\">{g.stats.totalPlays.toLocaleString()} plays</span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
