ext-slate-900\'\n                      }`}\n                    >\n                      <Layers className=\"w-3 h-3\" />\n                      Widget Only\n                    </button>\n                  </div>\n                ) : (\n                  <span className=\"text-[10px] text-emerald-600 font-bold bg-emerald-50 px-2.5 py-0.5 rounded-full\">STANDALONE CANVAS</span>\n                )}\n              </div>"
