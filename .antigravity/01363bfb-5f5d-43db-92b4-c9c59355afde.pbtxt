          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <stop offset=\"25%\" stopColor=\"#F97316\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <stop offset=\"50%\" stopColor=\"#FBBF24\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <stop offset=\"75%\" stopColor=\"#84CC16\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <stop offset=\"100%\" stopColor=\"#10B981\" />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  </linearGradient>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                </defs>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                {/* Semicircle Ticks Arc */}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                {Array.from({ length: 33 }).map((_, i) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  const angle = Math.PI + (i / 32) * Math.PI;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  const x1 = 100 + 82 * Math.cos(angle);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  const y1 = 105 + 82 * Math.sin(angle);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  const x2 = 100 + 68 * Math.cos(angle);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  const y2 = 105 + 68 * Math.sin(angle);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  // Color interpolations based on position"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  let tickColor = \'#10B981\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  if (i < 8) tickColor = \'#EF4444\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  else if (i < 16) tickColor = \'#F97316\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  else if (i < 24) tickColor = \'#FBBF24\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  else tickColor = \'#10B981\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  return ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    <line"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      key={i}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      x1={x1}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      y1={y1}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      x2={x2}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      y2={y2}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      stroke={tickColor}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      strokeWidth=\"2.2\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      strokeLinecap=\"round\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                })}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              </svg>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
