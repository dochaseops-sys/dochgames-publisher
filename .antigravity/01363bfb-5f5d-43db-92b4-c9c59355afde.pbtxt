    user_response: "Here is the full initial file tree for the application:\n/.env.example\n/.gitignore\n/bun.lock\n/index.html\n/metadata.json\n/package.json\n/server.ts\n/src/App.tsx\n/src/components/admin/AdminConsole.tsx\n/src/components/common/GigaMascot.tsx\n/src/components/common/PlayableGameModal.tsx\n/src/components/developer/DeveloperDashboard.tsx\n/src/components/developer/GameSubmissionPage.tsx\n/src/components/developer/MyGamesPage.tsx\n/src/components/developer/StudioProfilePage.tsx\n/src/components/layout/Navbar.tsx\n/src/components/notifications/NotificationCenter.tsx\n/src/components/publisher/BrandedGameHubPage.tsx\n/src/components/publisher/ConnectPropertyModal.tsx\n/src/components/publisher/MyWidgetsPage.tsx\n/src/components/publisher/PublisherAnalyticsPage.tsx\n/src/components/publisher/PublisherDashboard.tsx\n/src/components/publisher/WidgetBuilderPage.tsx\n/src/components/realtime/FileSharingHub.tsx\n/src/components/widgets/DochWidgetRenderer.tsx\n/src/components/widgets/LiveSitePlacementMock.tsx\n/src/data/mockData.ts\n/src/index.css\n/src/main.tsx\n/src/services/websocket.ts\n/src/types/index.ts\n/tsconfig.json\n/vite.config.ts\n\nThe following dependencies are installed:\n@google/genai: ^2.4.0\n@tailwindcss/vite: ^4.3.3\n@vitejs/plugin-react: ^6.1.1\ncanvas-confetti: ^1.9.4\ndotenv: ^17.2.3\nexpress: ^4.21.2\nlucide-react: ^0.546.0\nmotion: ^12.23.24\nreact: ^19.0.1\nreact-dom: ^19.0.1\nvite: ^8.3.0\nws: ^8.21.3\n\nThe following devDependencies are installed:\n@types/canvas-confetti: ^1.9.0\n@types/express: ^4.17.21\n@types/node: ^22.14.0\n@types/react: ^19.3.0\n@types/react-dom: ^19.3.0\n@types/ws: ^8.18.1\nautoprefixer: ^10.4.21\nesbuild: ^0.25.0\ntailwindcss: ^4.3.3\ntsx: ^4.21.0\ntypescript: ^7.0.2\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>DochGames - Game Distribution & Publisher Platform</title>\n    <meta name=\"description\" content=\"Enterprise game distribution platform connecting publishers with game developers. Featuring smart widgets, branded game hubs, automated validation, and real-time build & file sharing.\" />\n    <meta property=\"og:title\" content=\"DochGames - Game Distribution & Publisher Platform\" />\n    <meta property=\"og:description\" content=\"Enterprise game distribution platform connecting publishers with game developers. Featuring smart widgets, branded game hubs, automated validation, and real-time build & file sharing.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  </head>\n  <body class=\"bg-[#071B4B] text-slate-100 antialiased font-sans selection:bg-[#129BFF] selection:text-white\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Remix Remix DochGames - Game Distribution \\u0026 Publisher Platform\",\n  \"description\": \"Enterprise game distribution platform connecting publishers with game developers. Featuring smart widgets, branded game hubs, automated validation, and real-time build \\u0026 file sharing.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useEffect } from \'react\';\nimport { Navbar } from \'./components/layout/Navbar\';\nimport { PublisherDashboard } from \'./components/publisher/PublisherDashboard\';\nimport { WidgetBuilderPage } from \'./components/publisher/WidgetBuilderPage\';\nimport { MyWidgetsPage } from \'./components/publisher/MyWidgetsPage\';\nimport { BrandedGameHubPage } from \'./components/publisher/BrandedGameHubPage\';\nimport { PublisherAnalyticsPage } from \'./components/publisher/PublisherAnalyticsPage\';\nimport { ConnectPropertyModal } from \'./components/publisher/ConnectPropertyModal\';\nimport { DeveloperDashboard } from \'./components/developer/DeveloperDashboard\';\nimport { GameSubmissionPage } from \'./components/developer/GameSubmissionPage\';\nimport { MyGamesPage } from \'./components/developer/MyGamesPage\';\nimport { StudioProfilePage } from \'./components/developer/StudioProfilePage\';\nimport { AdminConsole } from \'./components/admin/AdminConsole\';\nimport { PlayableGameModal } from \'./components/common/PlayableGameModal\';\nimport { NotificationCenter } from \'./components/notifications/NotificationCenter\';\n\nimport { \n  UserRole, UserProfile, PublisherProperty, WidgetConfig, \n  GameItem, BrandedGameHub, ActivityEvent, PlatformNotification \n} from \'./types\';\nimport { \n  mockGames, mockProperties, mockWidgets, mockHubs, \n  mockActivities, mockNotifications, initialUsers \n} from \'./data/mockData\';\nimport { realtime } from \'./services/websocket\';\n\nexport function App() {\n  // Current user & role state\n  const [currentRole, setCurrentRole] = useState<UserRole>(\'publisher\');\n  const [currentView, setCurrentView] = useState<string>(\'dashboard\');\n  const [currentUser, setCurrentUser] = useState<UserProfile>(initialUsers[0]);\n\n  // Platform state\n  const [properties, setProperties] = useState<PublisherProperty[]>(mockProperties);\n  const [widgets, setWidgets] = useState<WidgetConfig[]>(mockWidgets);\n  const [games, setGames] = useState<GameItem[]>(mockGames);\n  const [hubs, setHubs] = useState<BrandedGameHub[]>(mockHubs);\n  const [activities, setActivities] = useState<ActivityEvent[]>(mockActivities);\n  const [notifications, setNotifications] = useState<PlatformNotification[]>(mockNotifications);\n  const [isNotificationsOpen, setIsNotificationsOpen] = useState<boolean>(false);\n\n  // Modals & Active Selections\n  const [isConnectModalOpen, setIsConnectModalOpen] = useState<boolean>(false);\n  const [selectedPlayableGame, setSelectedPlayableGame] = useState<GameItem | null>(null);\n  const [editingWidget, setEditingWidget] = useState<WidgetConfig | null>(null);\n  const [realtimeConnected, setRealtimeConnected] = useState<boolean>(false);\n\n  // Notification toast\n  const [toastNotification, setToastNotification] = useState<{ title: string; message: string } | null>(null);\n\n  const unreadNotificationsCount = notifications.filter(n => !n.read).length;\n\n  const handleMarkAsRead = (id: string) => {\n    setNotifications(prev => prev.map(n => n.id === id ? { ...n, read: !n.read } : n));\n  };\n\n  const handleMarkAllAsRead = () => {\n    setNotifications(prev => prev.map(n => ({ ...n, read: true })));\n  };\n\n  const handleClearAll = () => {\n    setNotifications([]);\n  };\n\n  const handleDeleteNotification = (id: string) => {\n    setNotifications(prev => prev.filter(n => n.id !== id));\n  };\n\n  const handleTriggerSampleAudit = () => {\n    const samples: Array<Omit<PlatformNotification, \'id\' | \'timestamp\' | \'read\'>> = [\n      {\n        category: \'audit\',\n        severity: \'success\',\n        title: \'Instant Sandbox Security Verification Passed\',\n        message: \'Pre-flight integrity check completed for newly compiled game assets. Zero external tracker injections found.\',\n        actor: { name: \'DochGames Sentinel Bot\', role: \'Automated QA Engine\' },\n        auditDetails: {\n          entityType: \'game\',\n          action: \'SANDBOX_PREFLIGHT_PASS\',\n          entityName: \'WebGL Sandbox Node #42\',\n          result: \'verified\',\n          checkDetails: \'Strict CSP isolated runtime \302\267 Zero script injection vulnerabilities detected\'\n        },\n        actionLabel: \'Inspect Sandbox Log\',\n        actionView: \'admin_console\'\n      },\n      {\n        category: \'activity\',\n        severity: \'info\',\n        title: \'New Game Start Surge Detected\',\n        message: \'A surge of 1,200 concurrent player sessions was recorded on syndicated partner widgets.\',\n        actor: { name: \'Edge Traffic Telemetry\', role: \'System\' },\n        actionLabel: \'View Analytics\',\n        actionView: \'publisher_analytics\'\n      },\n      {\n        category: \'audit\',\n        severity: \'warning\',\n        title: \'CSP Whitelist Origin Warning\',\n        message: \'External script request blocked on unverified domain origin. Host domain requires admin audit confirmation.\',\n        actor: { name: \'DochGames Security Daemon\', role: \'System\' },\n        auditDetails: {\n          entityType: \'property\',\n          action: \'CSP_ORIGIN_FLAGGED\',\n          ipOrOrigin: \'staging.partner-cdn.net\',\n          result: \'flagged\',\n          checkDetails: \'Non-TLS request prevented. Fallback to HTTPS enforced.\'\n        },\n        actionLabel: \'Review Admin Console\',\n        actionView: \'admin_console\'\n      },\n      {\n        category: \'system\',\n        severity: \'success\',\n        title: \'Dynamic Asset Optimization Deployed\',\n        message: \'DochGames WebGL Brotli/Wasm asset compression has successfully reduced initial game payload size by 38%.\',\n        actor: { name: \'CDN Optimizer\', role: \'System\' }\n      }\n    ];\n\n    const pick = samples[Math.floor(Math.random() * samples.length)];\n    const newNotif: PlatformNotification = {\n      ...pick,\n      id: `notif-${Date.now()}`,\n      timestamp: new Date().toISOString(),\n      read: false\n    };\n\n    setNotifications(prev => [newNotif, ...prev]);\n    setToastNotification({\n      title: newNotif.title,\n      message: newNotif.message\n    });\n    setTimeout(() => {\n      setToastNotification(null);\n    }, 4500);\n  };\n\n  // Helper to merge activities deduplicating by ID\n  const mergeActivities = (incoming: ActivityEvent[], existing: ActivityEvent[]): ActivityEvent[] => {\n    const seen = new Set<string>();\n    const merged: ActivityEvent[] = [];\n    for (const item of [...incoming, ...existing]) {\n      if (item && item.id && !seen.has(item.id)) {\n        seen.add(item.id);\n        merged.push(item);\n      }\n    }\n    return merged.slice(0, 30);\n  };\n\n  // Initialize Realtime WebSocket Connection & Listeners\n  useEffect(() => {\n    realtime.connect();\n\n    const unsubInit = realtime.on(\'init\', (payload) => {\n      setRealtimeConnected(true);\n      if (Array.isArray(payload.activities)) {\n        setActivities(prev => mergeActivities(payload.activities, prev));\n      }\n    });\n\n    const unsubActivity = realtime.on(\'activity\', (newActivity: ActivityEvent) => {\n      if (newActivity && newActivity.id) {\n        setActivities(prev => mergeActivities([newActivity], prev));\n      }\n    });\n\n    const unsubNotificationReceived = realtime.on(\'notification:received\', (payload: any) => {\n      if (payload?.activity) {\n        setActivities(prev => mergeActivities([payload.activity], prev));\n      }\n    });\n\n    const unsubNotification = realtime.on(\'notification\', (notif) => {\n      setToastNotification({\n        title: notif.action,\n        message: `${notif.actor}: ${notif.details}`\n      });\n      setTimeout(() => setToastNotification(null), 4000);\n    });\n\n    return () => {\n      unsubInit();\n      unsubActivity();\n      unsubNotificationReceived();\n      unsubNotification();\n    };\n  }, []);\n\n  // Update current user profile when role shifts\n  const handleRoleChange = (role: UserRole) => {\n    setCurrentRole(role);\n    setCurrentView(role === \'admin\' ? \'admin_console\' : \'dashboard\');\n    const matchedUser = initialUsers.find(u => u.role === role) || initialUsers[0];\n    setCurrentUser(matchedUser);\n  };\n\n  // Property creation handler\n  const handlePropertyCreated = (newProp: PublisherProperty) => {\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --doch-navy: #071B4B;\n    --doch-navy-dark: #040f2b;\n    --doch-navy-light: #0d276b;\n    --doch-white: #F5F8FF;\n    --doch-blue: #129BFF;\n    --doch-purple: #7B2CF5;\n    --doch-cyan: #11D9FF;\n    --doch-magenta: #D82CF4;\n    --doch-green: #16C965;\n    --doch-red: #FF4051;\n    --doch-yellow: #FFB51A;\n  }\n\n  body {\n    font-family: \'Inter\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n  }\n}\n\n.font-display {\n  font-family: \'Fredoka\', \'Inter\', sans-serif;\n}\n\n/* Custom scrollbars */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n::-webkit-scrollbar-track {\n  background: rgba(7, 27, 75, 0.4);\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(18, 155, 255, 0.3);\n  border-radius: 4px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(18, 155, 255, 0.6);\n}\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {StrictMode} from \'react\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\303\242\302\200\302\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
