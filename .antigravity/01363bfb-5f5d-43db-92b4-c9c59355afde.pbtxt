nt-medium\'\n                    }`}\n                  >\n                    Studio & Payouts\n                  </button>\n                </>\n              )}\n\n              {currentRole === \'admin\' && (\n                <button\n                  onClick={() => onNavigate(\'admin_console\')}\n                  className=\"px-5 py-2 rounded-full text-xs font-bold bg-[#D4F826] text-slate-950 shadow-xs\"\n                >\n                  Admin Operations\n                </button>\n              )}"
