  file_change {
    absolute_path_uri: "file:///src/components/developer/StudioProfilePage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { UserProfile } from \'../../types\';\nimport { Building, Globe, Mail, DollarSign, CheckCircle, Shield } from \'lucide-react\';\n\ninterface StudioProfilePageProps {\n  currentUser: UserProfile;\n  onUpdateProfile: (profile: Partial<UserProfile>) => void;\n}\n\nexport const StudioProfilePage: React.FC<StudioProfilePageProps> = ({\n  currentUser,\n  onUpdateProfile\n}) => {\n  const [studioName, setStudioName] = useState(currentUser.companyOrStudio || \'Velocity Pixel Labs\');\n  const [legalName, setLegalName] = useState(\'Velocity Interactive Corp.\');\n  const [contactEmail, setContactEmail] = useState(currentUser.email);\n  const [country, setCountry] = useState(currentUser.country || \'United States\');\n  const [website, setWebsite] = useState(currentUser.website || \'https://velocitypixel.dev\');\n  const [payoutMethod, setPayoutMethod] = useState<\'wire\' | \'stripe\' | \'paypal\'>(\'stripe\');\n  const [isSaved, setIsSaved] = useState(false);\n\n  const handleSave = () => {\n    onUpdateProfile({\n      companyOrStudio: studioName,\n      email: contactEmail,\n      country,\n      website\n    });\n    setIsSaved(true);\n    setTimeout(() => setIsSaved(false), 2000);\n  };\n\n  return (\n    <div className=\"space-y-6 max-w-4xl mx-auto\">\n      <div className=\"bg-white border border-slate-100 p-7 rounded-3xl shadow-xs flex items-center justify-between\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"text-[11px] font-bold text-blue-600 uppercase tracking-wider bg-blue-50 px-2.5 py-0.5 rounded-full\">\n              Commercial Entity\n            </span>\n            <span className=\"text-slate-400\">\302\267</span>\n            <span className=\"text-xs text-slate-500\">Legal & Settlements</span>\n          </div>\n          <h2 className=\"text-2xl font-extrabold text-slate-900 tracking-tight\">Studio Profile & Payout Settings</h2>\n          <p className=\"text-slate-500 text-xs mt-1\">Manage public studio information and commercial payout agreements.</p>\n        </div>\n        <button\n          onClick={handleSave}\n          className=\"px-6 py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold shadow-xs transition-all\"\n        >\n          Save Studio Profile\n        </button>\n      </div>\n\n      {isSaved && (\n        <div className=\"p-3.5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs flex items-center gap-2 animate-in fade-in\">\n          <CheckCircle className=\"w-4 h-4 text-emerald-600\" />\n          <span>Studio settings updated successfully.</span>\n        </div>\n      )}\n\n      {/* Public profile */}\n      <div className=\"bg-white border border-slate-100 rounded-3xl p-7 shadow-xs space-y-4\">\n        <h3 className=\"font-bold text-base text-slate-900 flex items-center gap-2\">\n          <Building className=\"w-4 h-4 text-[#2563EB]\" />\n          Public Studio Information\n        </h3>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">Studio Display Name</label>\n            <input\n              type=\"text\"\n              value={studioName}\n              onChange={(e) => setStudioName(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">Studio Website</label>\n            <input\n              type=\"text\"\n              value={website}\n              onChange={(e) => setWebsite(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">Contact Email</label>\n            <input\n              type=\"email\"\n              value={contactEmail}\n              onChange={(e) => setContactEmail(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">Country / Territory</label>\n            <input\n              type=\"text\"\n              value={country}\n              onChange={(e) => setCountry(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Commercial / Payout agreement */}\n      <div className=\"bg-white border border-slate-100 rounded-3xl p-7 shadow-xs space-y-4\">\n        <h3 className=\"font-bold text-base text-slate-900 flex items-center gap-2\">\n          <DollarSign className=\"w-4 h-4 text-amber-500\" />\n          Commercial Agreements & Payout Destination\n        </h3>\n        <p className=\"text-slate-500 text-xs\">\n          Commercial terms and payout accounts are strictly confidential and separated from public-facing catalogue profiles.\n        </p>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">Legal Entity / Registered Business Name</label>\n            <input\n              type=\"text\"\n              value={legalName}\n              onChange={(e) => setLegalName(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">Payout Channel</label>\n            <select\n              value={payoutMethod}\n              onChange={(e) => setPayoutMethod(e.target.value as any)}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            >\n              <option value=\"stripe\">Stripe Connect (Standard Rev-Share)</option>\n              <option value=\"wire\">Direct Bank Wire (SWIFT / IBAN)</option>\n              <option value=\"paypal\">PayPal Mass Pay</option>\n            </select>\n          </div>\n        </div>\n\n        <div className=\"p-4 bg-slate-50 rounded-2xl border border-slate-200 text-xs text-slate-600 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Shield className=\"w-4 h-4 text-emerald-600\" />\n            <span>Developer Commercial Agreement 2026: <strong className=\"text-slate-900\">Accepted & Signed</strong></span>\n          </div>\n          <span className=\"text-[11px] text-slate-500 font-mono\">Net-30 Terms</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
