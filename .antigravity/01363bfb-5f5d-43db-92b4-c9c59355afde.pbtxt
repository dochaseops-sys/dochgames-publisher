  file_change {
    absolute_path_uri: "file:///src/components/developer/DeveloperDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  Gamepad2, Plus, CheckCircle, Clock, AlertTriangle, \n  BarChart3, ArrowRight, Play, Users, Globe, ExternalLink, Sparkles \n} from \'lucide-react\';\nimport { GameItem, UserProfile } from \'../../types\';\nimport { GigaMascot } from \'../common/GigaMascot\';\n\ninterface DeveloperDashboardProps {\n  currentUser: UserProfile;\n  games: GameItem[];\n  onNavigateToSubmit: () => void;\n  onNavigateToPortfolio: () => void;\n  onNavigateToAnalytics: () => void;\n  onNavigateToProfile: () => void;\n  onPlayGame: (game: GameItem) => void;\n}\n\nexport const DeveloperDashboard: React.FC<DeveloperDashboardProps> = ({\n  currentUser,\n  games,\n  onNavigateToSubmit,\n  onNavigateToPortfolio,\n  onNavigateToAnalytics,\n  onNavigateToProfile,\n  onPlayGame\n}) => {\n  const liveCount = games.filter(g => g.status === \'live\').length;\n  const inReviewCount = games.filter(g => g.status === \'in_review\' || g.status === \'submitted\').length;\n  const changesCount = games.filter(g => g.status === \'changes_required\').length;\n  const totalPlays = games.reduce((acc, g) => acc + g.stats.totalPlays, 0);\n\n  return (\n    <div className=\"space-y-6 max-w-[1520px] mx-auto\">\n      {/* Top Banner */}\n      <div className=\"bg-white border border-slate-100 p-7 rounded-3xl shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-5\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"text-[11px] font-bold text-blue-600 uppercase tracking-wider bg-blue-50 px-2.5 py-0.5 rounded-full\">\n              Developer Studio Console\n            </span>\n            <span className=\"text-slate-400\">\302\267</span>\n            <span className=\"text-xs text-slate-500\">{currentUser.companyOrStudio || \'Independent Studio\'}</span>\n          </div>\n          <h2 className=\"text-2xl font-extrabold text-slate-900 tracking-tight\">\n            Studio Dashboard \302\267 {currentUser.name}\n          </h2>\n          <p className=\"text-slate-500 text-xs mt-1 max-w-xl\">\n            Distribute HTML5 & WebGL titles globally. Take advantage of automated pre-flight testing, fast human review, and real-time build synchronization.\n          </p>\n        </div>\n\n        {/* Primary CTA Submit a Game */}\n        <div className=\"flex items-center gap-3\">\n          <button\n            onClick={onNavigateToSubmit}\n            className=\"flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold shadow-xs transition-all\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            Submit a Game\n          </button>\n        </div>\n      </div>\n\n      {/* Actionable Feedback Alert if Changes Required */}\n      {changesCount > 0 && (\n        <div className=\"bg-amber-50 border border-amber-200 rounded-3xl p-5 flex items-center justify-between gap-4 animate-in fade-in\">\n          <div className=\"flex items-center gap-3\">\n            <AlertTriangle className=\"w-5 h-5 text-amber-600 shrink-0\" />\n            <div>\n              <span className=\"font-bold text-slate-900 text-xs block\">\n                {changesCount} submission requires actionable developer revisions\n              </span>\n              <span className=\"text-xs text-slate-500\">\n                DochGames QA reviewers have left specific notes on media or controls.\n              </span>\n            </div>\n          </div>\n          <button\n            onClick={onNavigateToPortfolio}\n            className=\"px-4 py-2 rounded-full bg-amber-500 text-slate-950 text-xs font-bold hover:bg-amber-400 transition-colors shrink-0\"\n          >\n            View Notes & Resubmit\n          </button>\n        </div>\n      )}\n\n      {/* Portfolio Summary KPI Cards */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n        <div \n          onClick={onNavigateToPortfolio}\n          className=\"bg-white border border-slate-100 hover:border-slate-200 rounded-3xl p-6 shadow-xs cursor-pointer transition-all flex flex-col justify-between\"\n        >\n          <div>\n            <div className=\"flex items-center justify-between text-slate-500 text-xs mb-2\">\n              <span>Live Distributed Titles</span>\n              <div className=\"w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center\">\n                <CheckCircle className=\"w-4 h-4\" />\n              </div>\n            </div>\n            <div className=\"text-3xl font-extrabold text-slate-900 tabular-nums\">\n              {liveCount} <span className=\"text-xs font-normal text-slate-400\">/ {games.length}</span>\n            </div>\n          </div>\n          <div className=\"text-xs text-emerald-600 font-semibold mt-4\">\n            Active on 180+ publisher domains\n          </div>\n        </div>\n\n        <div \n          onClick={onNavigateToPortfolio}\n          className=\"bg-white border border-slate-100 hover:border-slate-200 rounded-3xl p-6 shadow-xs cursor-pointer transition-all flex flex-col justify-between\"\n        >\n          <div>\n            <div className=\"flex items-center justify-between text-slate-500 text-xs mb-2\">\n              <span>In Review Queue</span>\n              <div className=\"w-8 h-8 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center\">\n                <Clock className=\"w-4 h-4\" />\n              </div>\n            </div>\n            <div className=\"text-3xl font-extrabold text-slate-900 tabular-nums\">\n              {inReviewCount} <span className=\"text-xs font-normal text-slate-400\">Titles</span>\n            </div>\n          </div>\n          <div className=\"text-xs text-slate-500 mt-4\">\n            Turnaround time &lt; 24 hours\n          </div>\n        </div>\n\n        <div \n          onClick={onNavigateToAnalytics}\n          className=\"bg-white border border-slate-100 hover:border-slate-200 rounded-3xl p-6 shadow-xs cursor-pointer transition-all flex flex-col justify-between\"\n        >\n          <div>\n            <div className=\"flex items-center justify-between text-slate-500 text-xs mb-2\">\n              <span>Total Player Starts</span>\n              <div className=\"w-8 h-8 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center\">\n                <BarChart3 className=\"w-4 h-4 text-[#2563EB]\" />\n              </div>\n            </div>\n            <div className=\"text-3xl font-extrabold text-slate-900 tabular-nums\">\n              {totalPlays.toLocaleString()}\n            </div>\n          </div>\n          <div className=\"text-xs text-emerald-600 font-semibold mt-4\">\n            +32% month-over-month\n          </div>\n        </div>\n\n        <div \n          onClick={onNavigateToProfile}\n          className=\"bg-white border border-slate-100 hover:border-slate-200 rounded-3xl p-6 shadow-xs cursor-pointer transition-all flex flex-col justify-between\"\n        >\n          <div>\n            <div className=\"flex items-center justify-between text-slate-500 text-xs mb-2\">\n              <span>Studio Profile Status</span>\n              <div className=\"w-8 h-8 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center\">\n                <Globe className=\"w-4 h-4\" />\n              </div>\n            </div>\n            <div className=\"text-3xl font-extrabold text-slate-900\">\n              Verified\n            </div>\n          </div>\n          <div className=\"text-xs text-slate-500 mt-4\">\n            Direct Wire & PayPal Connected\n          </div>\n        </div>\n      </div>\n\n      {/* Live Titles Spotlight & Giga Tip */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"lg:col-span-2 bg-white border border-slate-100 rounded-3xl p-7 shadow-xs space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"text-base font-bold text-slate-900\">\n              Your Top Performing Games\n            </h3>\n            <button\n              onClick={onNavigateToPortfolio}\n              className=\"text-xs font-bold text-blue-600 hover:underline\"\n            >\n              View Full Portfolio \342\206\222\n            </button>\n          </div>\n\n          <div className=\"space-y-3\">\n            {games.slice(0, 3).map(g => (\n              <div\n                key={g.id}\n                className=\"p-4 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-between gap-4\"\n              >\n                <div className=\"flex items-center gap-3\">\n                  <img\n                    src={g.media.thumbnailUrl}\n                    alt={g.title}\n                    className=\"w-14 h-14 rounded-xl object-cover shadow-2xs\"\n                  />\n                  <div>\n                    <h4 className=\"font-bold text-sm text-slate-900\">{g.title}</h4>\n                    <span className=\"text-xs text-slate-500\">{g.genre} \302\267 v{g.version} \302\267 \342\230\205 {g.stats.rating}</span>\n                    <div className=\"text-xs font-bold text-blue-600 mt-0.5 tabular-nums\">\n                      {g.stats.totalPlays.toLocaleString()} total plays\n                    </div>\n                  </div>\n                </div>\n\n                <button\n                  onClick={() => onPlayGame(g)}\n                  className=\"px-4 py-2 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold transition-colors shadow-xs\"\n                >\n                  <Play className=\"w-3.5 h-3.5 fill-current inline mr-1\" />\n                  Play\n                </button>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Mascot & Distribution Specs */}\n        <div className=\"space-y-4\">\n          <div className=\"bg-white border border-slate-100 rounded-3xl p-6 shadow-xs space-y-3 text-xs\">\n            <h4 className=\"font-bold text-slate-900 text-sm\">\n              Real-Time Build Distribution\n            </h4>\n            <p className=\"text-slate-500 leading-relaxed\">\n              When you upload builds (.zip or HTML5 packages), our WebSocket distribution relay immediately hashes and distributes them to connected publishers and QA testing sandboxes.\n            </p>\n          </div>\n\n          <GigaMascot\n            mood=\"helpful\"\n            size=\"md\"\n            speechBubble=\"Always make sure your audio context resumes on user touch to pass automated validation on mobile viewports!\"\n          />\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
      end_line: 223
      unified_diff {
