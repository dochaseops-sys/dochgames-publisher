  file_change {
    absolute_path_uri: "file:///src/components/publisher/PublisherDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  User, Heart, MoreHorizontal, ArrowUpRight, ArrowDown,\n  Globe, Layout, BarChart3, Plus, Key, CheckCircle, \n  ArrowRight, ShieldCheck, Flame, Play, AlertCircle, X, \n  ChevronRight, Eye, Copy, Check, Code2, Sparkles, Download,\n  Smile, Frown, Users, ExternalLink\n} from \'lucide-react\';\nimport { PublisherProperty, WidgetConfig, GameItem, ActivityEvent, UserProfile } from \'../../types\';\nimport { DochWidgetRenderer } from \'../widgets/DochWidgetRenderer\';\n\ninterface PublisherDashboardProps {\n  currentUser: UserProfile;\n  properties: PublisherProperty[];\n  widgets: WidgetConfig[];\n  games: GameItem[];\n  activities?: ActivityEvent[];\n  onOpenConnectModal: () => void;\n  onNavigateToBuilder: () => void;\n  onNavigateToHub: () => void;\n  onNavigateToAnalytics: () => void;\n  onNavigateToWidgets: () => void;\n  onPlayGame: (game: GameItem) => void;\n  onOpenNotifications?: () => void;\n}\n\nexport const PublisherDashboard: React.FC<PublisherDashboardProps> = ({\n  currentUser,\n  properties,\n  widgets,\n  games,\n  onOpenConnectModal,\n  onNavigateToBuilder,\n  onNavigateToHub,\n  onNavigateToAnalytics,\n  onNavigateToWidgets,\n  onPlayGame\n}) => {\n  // Chart timeframe state for Audience Growth\n  const [timeframe, setTimeframe] = useState<\'today\' | \'week\' | \'year\'>(\'year\');\n  const [hoveredMonth, setHoveredMonth] = useState<string | null>(null);\n  const [hoveredCountry, setHoveredCountry] = useState<string | null>(null);\n  const [showPartnersModal, setShowPartnersModal] = useState<boolean>(false);\n  const [copiedKey, setCopiedKey] = useState<boolean>(false);\n  const [selectedPreviewWidget, setSelectedPreviewWidget] = useState<WidgetConfig>(widgets[0] || {} as WidgetConfig);\n\n  const primaryProperty = properties[0];\n\n  const copyEmbedSnippet = () => {\n    const snippet = `<script async src=\"https://cdn.dochgames.com/sdk/v2/loader.js\" data-publisher-key=\"${primaryProperty?.publisherKey || \'pub_live_demo\'}\"></script>\\n<div id=\"doch-widget-root\"></div>`;\n    navigator.clipboard.writeText(snippet);\n    setCopiedKey(true);\n    setTimeout(() => setCopiedKey(false), 2500);\n  };\n\n  const handleExportReport = () => {\n    const csvContent = \"data:text/csv;charset=utf-8,\" \n      + \"Country,Share,Players,CTR,Impressions\\n\"\n      + \"United States,50%,64210,5.2%,645000\\n\"\n      + \"Canada,20%,25684,4.9%,258000\\n\"\n      + \"Ukraine,20%,25684,4.7%,256000\\n\"\n      + \"Spain,10%,12842,4.1%,129000\\n\"\n      + \"United Kingdom,10%,12842,4.4%,130000\\n\";\n    const encodedUri = encodeURI(csvContent);\n    const link = document.createElement(\"a\");\n    link.setAttribute(\"href\", encodedUri);\n    link.setAttribute(\"download\", `dochgames_audience_report_${new Date().toISOString().slice(0, 10)}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n  };\n\n  // CTR monthly bar data\n  const ctrBars = [\n    { month: \'Jan\', totalHeight: 75, activeHeight: 45, clicks: 1840, rate: \'4.2%\' },\n    { month: \'Mar\', totalHeight: 88, activeHeight: 62, clicks: 2420, rate: \'4.8%\' },\n    { month: \'May\', totalHeight: 70, activeHeight: 38, clicks: 1650, rate: \'3.9%\' },\n    { month: \'Jul\', totalHeight: 92, activeHeight: 52, clicks: 2190, rate: \'4.5%\' },\n    { month: \'Sep\', totalHeight: 80, activeHeight: 46, clicks: 1980, rate: \'4.3%\' },\n    { month: \'Nov\', totalHeight: 85, activeHeight: 58, clicks: 2340, rate: \'4.7%\' },\n    { month: \'Dec\', totalHeight: 95, activeHeight: 70, clicks: 2890, rate: \'5.1%\' }\n  ];\n\n  // Top Countries Data\n  const topCountries = [\n    { name: \'United States\', flag: \'\360\237\207\272\360\237\207\270\', percent: 50, code: \'US\', color: \'#2563EB\' },\n    { name: \'Canada\', flag: \'\360\237\207\250\360\237\207\246\', percent: 20, code: \'CA\', color: \'#3B82F6\' },\n    { name: \'Ukraine\', flag: \'\360\237\207\272\360\237\207\246\', percent: 20, code: \'UA\', color: \'#60A5FA\' },\n    { name: \'Spain\', flag: \'\360\237\207\252\360\237\207\270\', percent: 10, code: \'ES\', color: \'#93C5FD\' },\n    { name: \'United Kingdom\', flag: \'\360\237\207\254\360\237\207\247\', percent: 10, code: \'GB\', color: \'#BFDBFE\' }\n  ];\n\n  // Partner list for modal\n  const partnersList = [\n    { name: \'Emily Zhang\', studio: \'Polygon Pulse Media\', role: \'Editorial Director\', avatar: \'EZ\', color: \'bg-emerald-500\', properties: 4, monthlyPlays: \'420,000\' },\n    { name: \'Marcus Vance\', studio: \'Arcade Syndicate\', role: \'Head of Growth\', avatar: \'MV\', color: \'bg-blue-600\', properties: 2, monthlyPlays: \'280,000\' },\n    { name: \'Sofia Rodriguez\', studio: \'GameZone Daily\', role: \'Lead Publisher\', avatar: \'SR\', color: \'bg-purple-600\', properties: 6, monthlyPlays: \'890,000\' },\n    { name: \'David Chen\', studio: \'Velocity Pixel Labs\', role: \'Studio Founder\', avatar: \'DC\', color: \'bg-amber-500\', properties: 3, monthlyPlays: \'310,000\' },\n    { name: \'Chloe Laurent\', studio: \'HyperCasual Hub\', role: \'Operations\', avatar: \'CL\', color: \'bg-rose-500\', properties: 5, monthlyPlays: \'520,000\' }\n  ];\n\n  return (\n    <div className=\"space-y-8 max-w-[1520px] mx-auto pb-12\">\n      \n      {/* ========================================================================= */}\n      {/* EXACT REFERENCE UI: ROW 1 (3 CARDS)                                       */}\n      {/* ========================================================================= */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch\">\n        \n        {/* CARD 1: Metric Stack (Followers & Likes) - Spans 3 cols */}\n        <div className=\"md:col-span-12 lg:col-span-3 bg-white rounded-3xl p-7 shadow-xs border border-slate-100 flex flex-col justify-between\">\n          {/* Top Metric: Followers / Active Players */}\n          <div>\n            <div className=\"w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4\">\n              <User className=\"w-5 h-5 text-[#2563EB]\" />\n            </div>\n            <div className=\"text-xs font-medium text-slate-500\">\n              Followers\n            </div>\n            <div className=\"flex items-center gap-3 mt-1.5\">\n              <span className=\"text-3xl font-extrabold text-slate-900 tracking-tight tabular-nums\">\n                128,420\n              </span>\n              <span className=\"inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-600\">\n                <span className=\"text-[11px]\">\342\206\221</span> 25%\n              </span>\n            </div>\n          </div>\n\n          <div className=\"my-6 border-t border-slate-100/80\" />\n\n          {/* Bottom Metric: Likes / Game Plays */}\n          <div>\n            <div className=\"w-10 h-10 rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mb-4\">\n              <Heart className=\"w-5 h-5 fill-red-500 text-red-500\" />\n            </div>\n            <div className=\"text-xs font-medium text-slate-500\">\n              Likes\n            </div>\n            <div className=\"flex items-center gap-3 mt-1.5\">\n              <span className=\"text-3xl font-extrabold text-slate-900 tracking-tight tabular-nums\">\n                66,816\n              </span>\n              <span className=\"inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-600\">\n                <span className=\"text-[11px]\">\342\206\221</span> 32%\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* CARD 2: Click-through rate (CTR) Bar Chart - Spans 4 cols */}\n        <div className=\"md:col-span-12 lg:col-span-4 bg-white rounded-3xl p-7 shadow-xs border border-slate-100 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-base font-bold text-slate-900\">\n                Click-through rate (CTR)\n              </h3>\n              <button \n                onClick={onNavigateToAnalytics}\n                className=\"text-slate-400 hover:text-slate-600 p-1 rounded-full hover:bg-slate-50\"\n                title=\"View detailed CTR\"\n              >\n                <MoreHorizontal className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"flex items-center gap-3 mt-3\">\n              <span className=\"text-3xl font-extrabold text-slate-900 tracking-tight tabular-nums\">\n                2,420\n              </span>\n              <span className=\"inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-600\">\n                <span className=\"text-[11px]\">\342\206\221</span> 28%\n              </span>\n            </div>\n          </div>\n\n          {/* Bar Chart Container matching screenshot aesthetic */}\n          <div className=\"mt-8 pt-4\">\n            <div className=\"h-44 flex items-end justify-between gap-3 px-1\">\n              {ctrBars.map((bar, idx) => (\n                <div \n                  key={bar.month} \n                  className=\"flex-1 flex flex-col items-center h-full justify-end group cursor-pointer relative\"\n                  onMouseEnter={() => setHoveredMonth(bar.month)}\n                  onMouseLeave={() => setHoveredMonth(null)}\n                >\n                  {/* Tooltip on hover */}\n                  {hoveredMonth === bar.month && (\n                    <div className=\"absolute -top-10 z-20 bg-slate-900 text-white text-[11px] font-semibold py-1 px-2 rounded-lg shadow-lg whitespace-nowrap animate-in fade-in\">\n                      {bar.clicks.toLocaleString()} clicks ({bar.rate})\n                    </div>\n                  )}\n\n                  {/* Dual-bar stack: tall light gray background bar + vibrant orange foreground bar */}\n                  <div \n                    className=\"w-full max-w-[28px] bg-slate-100/90 rounded-t-lg relative overflow-hidden transition-all duration-300 group-hover:bg-slate-200\"\n                    style={{ height: `${bar.totalHeight}%` }}\n                  >\n                    <div \n                      className=\"absolute bottom-0 inset-x-0 bg-[#FF6B2C] rounded-t-lg transition-all duration-500 group-hover:bg-[#fa5a1e]\"\n                      style={{ height: `${bar.activeHeight}%` }}\n                    />\n                  </div>\n\n                  <span className=\"text-xs text-slate-400 font-medium mt-3\">\n                    {bar.month}\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* CARD 3: Audience Growth (Smooth Wave Line Chart) - Spans 5 cols */}\n        <div className=\"md:col-span-12 lg:col-span-5 bg-white rounded-3xl p-7 shadow-xs border border-slate-100 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n              <h3 className=\"text-base font-bold text-slate-900\">\n                Audience Growth\n              </h3>\n\n              {/* Timeframe pill selector */}\n              <div className=\"inline-flex items-center bg-slate-100/80 p-1 rounded-full text-xs\">\n                <button\n                  onClick={() => setTimeframe(\'today\')}\n                  className={`px-3 py-1 rounded-full transition-all font-medium ${\n                    timeframe === \'today\'\n                      ? \'bg-white text-slate-900 shadow-2xs font-bold\'\n                      : \'text-slate-500 hover:text-slate-800\'\n                  }`}\n                >\n                  Today\n                </button>\n                <button\n                  onClick={() => setTimeframe(\'week\')}\n                  className={`px-3 py-1 rounded-full transition-all font-medium ${\n                    timeframe === \'week\'\n                      ? \'bg-white text-slate-900 shadow-2xs font-bold\'\n                      : \'text-slate-500 hover:text-slate-800\'\n                  }`}\n                >\n                  This Week\n                </button>\n                <button\n                  onClick={() => setTimeframe(\'year\')}\n                  className={`px-3.5 py-1 rounded-full transition-all font-bold ${\n                    timeframe === \'year\'\n                      ? \'bg-[#D4F826] text-slate-950 shadow-2xs\'\n                      : \'text-slate-500 hover:text-slate-800\'\n                  }`}\n                >\n                  This Year\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Smooth Bezier Wave Chart with Pinned Tooltip */}\n          <div className=\"mt-6 relative h-48 flex\">\n            {/* Y-Axis Labels */}\n            <div className=\"flex flex-col justify-between text-xs text-slate-400 font-medium pr-3 py-1 select-none\">\n              <span>80k</span>\n              <span>60k</span>\n              <span>40k</span>\n              <span>20k</span>\n            </div>\n\n            {/* SVG Canvas for Wave & Tooltip */}\n            <div className=\"flex-1 relative h-full\">\n              <svg \n                viewBox=\"0 0 500 180\" \n                preserveAspectRatio=\"none\" \n                className=\"w-full h-full overflow-visible\"\n              >\n                <defs>\n                  <linearGradient id=\"blueWaveGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"0%\" stopColor=\"#2563EB\" stopOpacity=\"0.22\" />\n                    <stop offset=\"70%\" stopColor=\"#2563EB\" stopOpacity=\"0.04\" />\n                    <stop offset=\"100%\" stopColor=\"#2563EB\" stopOpacity=\"0.0\" />\n                  </linearGradient>\n                </defs>\n\n                {/* Subtle horizontal grid guide lines */}\n                <line x1=\"0\" y1=\"20\" x2=\"500\" y2=\"20\" stroke=\"#F1F5F9\" strokeWidth=\"1\" />\n                <line x1=\"0\" y1=\"65\" x2=\"500\" y2=\"65\" stroke=\"#F1F5F9\" strokeWidth=\"1\" />\n                <line x1=\"0\" y1=\"110\" x2=\"500\" y2=\"110\" stroke=\"#F1F5F9\" strokeWidth=\"1\" />\n                <line x1=\"0\" y1=\"155\" x2=\"500\" y2=\"155\" stroke=\"#F1F5F9\" strokeWidth=\"1\" />\n\n                {/* Area under the curve */}\n                <path\n                  d=\"M 10 150 \n                     C 60 148, 90 140, 130 115 \n                     C 160 90, 190 55, 230 58 \n                     C 270 61, 290 85, 330 68 \n                     C 370 52, 400 75, 440 60 \n                     C 460 45, 480 30, 500 20 \n                     L 500 170 L 10 170 Z\"\n                  fill=\"url(#blueWaveGrad)\"\n                />\n\n                {/* Main Blue Stroke Line */}\n                <path\n                  d=\"M 10 150 \n                     C 60 148, 90 140, 130 115 \n                     C 160 90, 190 55, 230 58 \n                     C 270 61, 290 85, 330 68 \n                     C 370 52, 400 75, 440 60 \n                     C 460 45, 480 30, 500 20\"\n                  fill=\"none\"\n                  stroke=\"#2563EB\"\n                  strokeWidth=\"2.5\"\n                  strokeLinecap=\"round\"\n                />\n\n                {/* Vertical Dashed Guide Line for March peak */}\n                <line \n                  x1=\"230\" \n                  y1=\"58\" \n                  x2=\"230\" \n                  y2=\"170\" \n                  stroke=\"#2563EB\" \n                  strokeWidth=\"1.5\" \n                  strokeDasharray=\"4,4\" \n                />\n\n                {/* Highlight Circle on the line */}\n                <circle cx=\"230\" cy=\"58\" r=\"4.5\" fill=\"#2563EB\" stroke=\"#FFFFFF\" strokeWidth=\"2.5\" />\n              </svg>\n\n              {/* Pinned 42,4k Dark Pill Tooltip at the peak (as shown in image) */}\n              <div \n                className=\"absolute z-10 -translate-x-1/2 flex flex-col items-center pointer-events-none\"\n                style={{ left: \'46%\', top: \'16%\' }}\n              >\n                <div className=\"bg-slate-900 text-white font-bold text-xs px-3 py-1.2 rounded-lg shadow-md tracking-tight\">\n                  42,4k\n                </div>\n                {/* Little triangle arrow pointer */}\n                <div className=\"w-0 h-0 border-x-4 border-x-transparent border-t-4 border-t-slate-900\" />\n              </div>\n            </div>\n          </div>\n\n          {/* X-Axis Month Labels */}\n          <div className=\"flex justify-between pl-8 pr-2 pt-2 text-xs text-slate-400 font-medium\">\n            <span>Jan</span>\n            <span>Feb</span>\n            <span className=\"font-bold text-slate-700\">Mar</span>\n            <span>Apr</span>\n            <span>Jun</span>\n            <span>Jul</span>\n            <span>Aug</span>\n          </div>\n        </div>\n\n      </div>\n\n      {/* ========================================================================= */}\n      {/* EXACT REFERENCE UI: ROW 2 (MAP & SENTIMENT/CUSTOMERS)                     */}\n      {/* ========================================================================= */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch\">\n        \n        {/* CARD 4: Audience Location (Interactive Map & Top Countries) - Spans 8 cols */}\n        <div className=\"md:col-span-12 lg:col-span-8 bg-white rounded-3xl p-7 shadow-xs border border-slate-100 flex flex-col justify-between\">\n          <div className=\"flex items-center justify-between pb-4\">\n            <h3 className=\"text-base font-bold text-slate-900\">\n              Audience Location\n            </h3>\n\n            {/* Export Report Button */}\n            <button\n              onClick={handleExportReport}\n              className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200/90 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-colors shadow-2xs\"\n            >\n              <span>Export Report</span>\n              <Download className=\"w-3.5 h-3.5 text-slate-500\" />\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center pt-2\">\n            \n            {/* Left: SVG World Map with Highlighted Regions */}\n            <div className=\"lg:col-span-7 relative flex items-center justify-center p-2\">\n              <svg \n                viewBox=\"0 0 650 360\" \n                className=\"w-full h-auto max-h-[290px] select-none\"\n              >\n                {/* SVG Vector Map Shapes matching TrendTide screenshot */}\n                <g className=\"transition-all duration-300\">\n                  {/* North America (Highlighted #2563EB) */}\n                  <path\n                    d=\"M 60 70 \n                       C 80 50, 130 40, 180 55 \n                       C 210 65, 230 80, 220 110 \n                       C 210 130, 190 145, 170 160 \n                       C 150 180, 130 200, 120 220 \n                       C 110 215, 100 200, 95 185 \n                       C 85 160, 60 140, 50 110 \n                       C 45 90, 50 80, 60 70 Z\"\n                    fill=\"#2563EB\"\n                    className=\"hover:opacity-90 transition-opacity cursor-pointer\"\n                    onMouseEnter={() => setHoveredCountry(\'United States & Canada (70%)\')}\n                    onMouseLeave={() => setHoveredCountry(null)}\n                  />\n\n                  {/* South America (Soft Slate #E2E8F0) */}\n                  <path\n                    d=\"M 140 210 \n                       C 165 215, 185 235, 180 260 \n                       C 175 285, 160 320, 145 340 \n                       C 135 345, 130 330, 125 310 \n                       C 120 280, 125 240, 140 210 Z\"\n                    fill=\"#E2E8F0\"\n                    className=\"hover:fill-slate-300 transition-colors\"\n                  />\n\n                  {/* Europe (Highlighted Ukraine & Western Europe in #3B82F6 & #60A5FA) */}\n                  <path\n                    d=\"M 285 70 \n                       C 310 65, 335 70, 340 90 \n                       C 345 105, 330 120, 310 125 \n                       C 295 125, 280 115, 275 100 \n                       C 270 85, 275 75, 285 70 Z\"\n                    fill=\"#3B82F6\"\n                    className=\"hover:opacity-90 transition-opacity cursor-pointer\"\n                    onMouseEnter={() => setHoveredCountry(\'Europe & Ukraine (30%)\')}\n                    onMouseLeave={() => setHoveredCountry(null)}\n                  />\n\n                  {/* Ukraine hotspot highlight */}\n                  <circle \n                    cx=\"335\" \n                    cy=\"85\" \n                    r=\"8\" \n                    fill=\"#60A5FA\" \n                    className=\"animate-pulse\"\n                  />\n\n                  {/* Africa (Soft Slate #E2E8F0) */}\n                  <path\n                    d=\"M 290 140 \n                       C 320 140, 345 160, 350 190 \n                       C 355 220, 340 260, 320 280 \n                       C 300 290, 290 270, 280 240 \n                       C 270 200, 275 160, 290 140 Z\"\n                    fill=\"#E2E8F0\"\n                    className=\"hover:fill-slate-300 transition-colors\"\n                  />\n\n                  {/* Asia (Soft Slate #E2E8F0) */}\n                  <path\n                    d=\"M 350 65 \n                       C 400 50, 480 55, 520 85 \n                       C 540 105, 530 140, 500 160 \n                       C 470 175, 430 165, 400 160 \n                       C 370 155, 355 130, 345 100 \n                       C 340 80, 345 70, 350 65 Z\"\n                    fill=\"#E2E8F0\"\n                    className=\"hover:fill-slate-300 transition-colors\"\n                  />\n\n                  {/* Australia (Highlighted in light periwinkle #93C5FD) */}\n                  <path\n                    d=\"M 470 240 \n                       C 500 235, 525 250, 520 275 \n                       C 515 295, 490 305, 465 295 \n                       C 450 285, 455 255, 470 240 Z\"\n                    fill=\"#93C5FD\"\n                    className=\"hover:opacity-90 transition-opacity cursor-pointer\"\n                    onMouseEnter={() => setHoveredCountry(\'Australia (5%)\')}\n                    onMouseLeave={() => setHoveredCountry(null)}\n                  />\n                </g>\n              </svg>\n\n              {/* Floating Country Details Pill on map hover */}\n              {hoveredCountry && (\n                <div className=\"absolute bottom-2 left-4 bg-slate-900 text-white text-xs font-semibold px-3 py-1.5 rounded-full shadow-lg\">\n                  {hoveredCountry}\n                </div>\n              )}\n            </div>\n\n            {/* Right: Top Countries Progress List */}\n            <div className=\"lg:col-span-5 space-y-4 pl-0 lg:pl-4\">\n              <h4 className=\"text-sm font-bold text-slate-800 mb-3\">\n                Top Countries\n              </h4>\n\n              <div className=\"space-y-4\">\n                {topCountries.map((country) => (\n                  <div key={country.name} className=\"space-y-1.5\">\n                    <div className=\"flex items-center justify-between text-xs font-semibold text-slate-700\">\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"text-base leading-none\">{country.flag}</span>\n                        <span>{country.name}</span>\n                      </div>\n                      <span className=\"tabular-nums font-bold text-slate-900\">{country.percent}%</span>\n                    </div>\n\n                    {/* Progress Bar with rounded ends matching image */}\n                    <div className=\"w-full bg-slate-100 rounded-full h-2 overflow-hidden\">\n                      <div \n                        className=\"h-2 rounded-full transition-all duration-700\"\n                        style={{ \n                          width: `${country.percent}%`,\n                          backgroundColor: country.color\n                        }}\n                      />\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n          </div>\n        </div>\n\n        {/* RIGHT COLUMN: 2 STACKED CARDS (Sentiment Analysis + Total Customers) - Spans 4 cols */}\n        <div className=\"md:col-span-12 lg:col-span-4 flex flex-col gap-6\">\n          \n          {/* CARD 5: Sentiment Analysis (Radial Speedometer Gauge) */}\n          <div className=\"bg-white rounded-3xl p-6 shadow-xs border border-slate-100 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between\">\n              <h3 className=\"text-base font-bold text-slate-900\">\n                Sentiment Analysis\n              </h3>\n              <button \n                onClick={onNavigateToAnalytics}\n                className=\"text-slate-400 hover:text-slate-600 p-1 rounded-full hover:bg-slate-50\"\n              >\n                <MoreHorizontal className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            {/* Speedometer Arc SVG */}\n            <div className=\"relative flex flex-col items-center justify-center my-2\">\n              <svg viewBox=\"0 0 200 115\" className=\"w-48 h-28 overflow-visible\">\n                <defs>\n                  <linearGradient id=\"gaugeGradient\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n                    <stop offset=\"0%\" stopColor=\"#EF4444\" />\n                    <stop offset=\"25%\" stopColor=\"#F97316\" />\n                    <stop offset=\"50%\" stopColor=\"#FBBF24\" />\n                    <stop offset=\"75%\" stopColor=\"#84CC16\" />\n                    <stop offset=\"100%\" stopColor=\"#10B981\" />\n                  </linearGradient>\n                </defs>\n\n                {/* Semicircle Ticks Arc */}\n                {Array.from({ length: 33 }).map((_, i) => {\n                  const angle = Math.PI + (i / 32) * Math.PI;\n                  const x1 = 100 + 82 * Math.cos(angle);\n                  const y1 = 105 + 82 * Math.sin(angle);\n                  const x2 = 100 + 68 * Math.cos(angle);\n                  const y2 = 105 + 68 * Math.sin(angle);\n\n                  // Color interpolations based on position\n                  let tickColor = \'#10B981\';\n                  if (i < 8) tickColor = \'#EF4444\';\n                  else if (i < 16) tickColor = \'#F97316\';\n                  else if (i < 24) tickColor = \'#FBBF24\';\n                  else tickColor = \'#10B981\';\n\n                  return (\n                    <line\n                      key={i}\n                      x1={x1}\n                      y1={y1}\n                      x2={x2}\n                      y2={y2}\n                      stroke={tickColor}\n                      strokeWidth=\"2.2\"\n                      strokeLinecap=\"round\"\n                    />\n                  );\n                })}\n              </svg>\n\n              {/* Emoji Faces on left and right */}\n              <div className=\"w-full flex items-center justify-between px-3 -mt-6\">\n                <div className=\"w-5 h-5 rounded-full bg-red-100 text-red-500 flex items-center justify-center text-xs\">\n                  \360\237\231\201\n                </div>\n                <div className=\"w-5 h-5 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs\">\n                  \360\237\230\212\n                </div>\n              </div>\n\n              {/* Central Bold Score & Positive Badge */}\n              <div className=\"text-center mt-1\">\n                <div className=\"text-3xl font-extrabold text-slate-900 tracking-tight\">\n                  4.85\n                </div>\n                <div className=\"inline-flex items-center gap-1.5 px-3 py-1 mt-2 rounded-full text-xs font-bold bg-emerald-50 text-emerald-600 border border-emerald-100/60\">\n                  <span>\360\237\230\212</span>\n                  <span>Positive</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* CARD 6: Total Customers (with Overlapping Avatars & Show All Link) */}\n          <div className=\"bg-white rounded-3xl p-6 shadow-xs border border-slate-100 flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center justify-between\">\n                <h3 className=\"text-base font-bold text-slate-900\">\n                  Total customers\n                </h3>\n                <button \n                  onClick={() => setShowPartnersModal(true)}\n                  className=\"text-slate-400 hover:text-slate-600 p-1 rounded-full hover:bg-slate-50\"\n                >\n                  <MoreHorizontal className=\"w-4 h-4\" />\n                </button>\n              </div>\n\n              <div className=\"flex items-center gap-3 mt-3\">\n                <span className=\"text-3xl font-extrabold text-slate-900 tracking-tight tabular-nums\">\n                  2,420\n                </span>\n                <span className=\"inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-600\">\n                  <span className=\"text-[11px]\">\342\206\221</span> 25%\n                </span>\n              </div>\n            </div>\n\n            {/* Overlapping User Avatars Row & Show All Link */}\n            <div className=\"mt-6 flex items-center justify-between\">\n              {/* 4 Overlapping Avatar Circles */}\n              <div className=\"flex -space-x-3 overflow-hidden p-1\">\n                <div className=\"inline-block h-10 w-10 rounded-full ring-2 ring-white bg-blue-500 text-white font-bold text-xs flex items-center justify-center shadow-xs\">\n                  EZ\n                </div>\n                <div className=\"inline-block h-10 w-10 rounded-full ring-2 ring-white bg-indigo-500 text-white font-bold text-xs flex items-center justify-center shadow-xs\">\n                  MV\n                </div>\n                <div className=\"inline-block h-10 w-10 rounded-full ring-2 ring-white bg-emerald-500 text-white font-bold text-xs flex items-center justify-center shadow-xs\">\n                  SR\n                </div>\n                <div className=\"inline-block h-10 w-10 rounded-full ring-2 ring-white bg-amber-500 text-white font-bold text-xs flex items-center justify-center shadow-xs\">\n                  DC\n                </div>\n              </div>\n\n              {/* Show All Link with Right Arrow */}\n              <button\n                onClick={() => setShowPartnersModal(true)}\n                className=\"text-xs font-bold text-slate-900 hover:text-blue-600 flex items-center gap-1 transition-colors group\"\n              >\n                <span>Show All</span>\n                <span className=\"group-hover:translate-x-0.5 transition-transform\">\342\206\222</span>\n              </button>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* ========================================================================= */}\n      {/* DOCHGAMES OPERATIONAL WORKSPACE (WIDGET RUNNER & SYNDICATION CONTROLS)   */}\n      {/* ========================================================================= */}\n      <div className=\"pt-4 space-y-6\">\n        \n        {/* Interactive Live Widget Preview Deck */}\n        <div className=\"bg-white rounded-3xl p-7 shadow-xs border border-slate-100\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-slate-100\">\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse\" />\n                <h3 className=\"text-lg font-bold text-slate-900\">\n                  Live Syndicated Smart Widget Preview\n                </h3>\n              </div>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Interact with your active game distribution feed directly. Click any game card to launch the playable sandbox.\n              </p>\n            </div>\n\n            <div className=\"flex items-center gap-2.5\">\n              <button\n                onClick={onNavigateToWidgets}\n                className=\"px-4 py-2 rounded-full border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors\"\n              >\n                Manage All ({widgets.length})\n              </button>\n\n              <button\n                onClick={onNavigateToBuilder}\n                className=\"px-4 py-2 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold transition-all shadow-xs flex items-center gap-1.5\"\n              >\n                <Plus className=\"w-4 h-4\" />\n                <span>Build New Widget</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Active Widget Layout Renderer */}\n          <div className=\"pt-6\">\n            {widgets.length > 0 ? (\n              <div className=\"space-y-3\">\n                <div className=\"flex items-center justify-between text-xs text-slate-500 px-1\">\n                  <span>Displaying: <strong className=\"text-slate-800\">{widgets[0].name}</strong> ({widgets[0].layout.replace(\'_\', \' \')})</span>\n                  <span className=\"text-emerald-600 font-semibold flex items-center gap-1\">\n                    <CheckCircle className=\"w-3.5 h-3.5\" /> High Responsive Mode\n                  </span>\n                </div>\n                <div className=\"p-4 bg-slate-50 rounded-2xl border border-slate-200/60\">\n                  <DochWidgetRenderer\n                    config={widgets[0]}\n                    games={games}\n                    onPlayGame={onPlayGame}\n                  />\n                </div>\n              </div>\n            ) : (\n              <div className=\"p-8 text-center bg-slate-50 rounded-2xl\">\n                <p className=\"text-slate-500 text-xs\">No widgets configured yet.</p>\n                <button\n                  onClick={onNavigateToBuilder}\n                  className=\"mt-3 px-4 py-2 bg-blue-600 text-white rounded-full text-xs font-bold\"\n                >\n                  Create First Widget\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Quick Launch & Publisher Key Snippet */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          \n          {/* Quick Snippet Embed Box */}\n          <div className=\"bg-white rounded-3xl p-7 shadow-xs border border-slate-100 flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center justify-between mb-2\">\n                <h4 className=\"text-sm font-bold text-slate-900 flex items-center gap-2\">\n                  <Code2 className=\"w-4 h-4 text-blue-600\" />\n                  Quick Embed Script\n                </h4>\n                <span className=\"text-[10px] font-mono bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full font-semibold\">\n                  SDK v2.4 (Async)\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-500 mb-4\">\n                Paste this one-line script snippet into your website header or CMS to initialize DochGames distribution.\n              </p>\n\n              <div className=\"relative bg-slate-900 text-slate-200 p-4 rounded-2xl font-mono text-[11px] overflow-x-auto border border-slate-800\">\n                <code>{`<script async src=\"https://cdn.dochgames.com/sdk/v2/loader.js\" data-publisher-key=\"${primaryProperty?.publisherKey || \'pub_live_demo\'}\"></script>`}</code>\n              </div>\n            </div>\n\n            <div className=\"mt-4 flex items-center justify-between\">\n              <span className=\"text-xs text-slate-400\">\n                Property: <strong>{primaryProperty?.domain || \'localhost:3000\'}</strong>\n              </span>\n\n              <button\n                onClick={copyEmbedSnippet}\n                className=\"inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold transition-colors\"\n              >\n                {copiedKey ? <Check className=\"w-3.5 h-3.5 text-emerald-600\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copiedKey ? \'Copied to Clipboard\' : \'Copy Embed Code\'}</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Quick Actions Card */}\n          <div className=\"bg-white rounded-3xl p-7 shadow-xs border border-slate-100 flex flex-col justify-between\">\n            <div>\n              <h4 className=\"text-sm font-bold text-slate-900 mb-2 flex items-center gap-2\">\n                <Sparkles className=\"w-4 h-4 text-[#FF6B2C]\" />\n                Explore Syndication Tools\n              </h4>\n              <p className=\"text-xs text-slate-500 mb-4\">\n                Boost your domain monetization with dedicated branded hubs and verified origins.\n              </p>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <button\n                  onClick={onOpenConnectModal}\n                  className=\"p-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-100 text-left transition-colors group\"\n                >\n                  <Globe className=\"w-4 h-4 text-blue-600 mb-2 group-hover:scale-110 transition-transform\" />\n                  <div className=\"text-xs font-bold text-slate-800\">Connect Domain</div>\n                  <div className=\"text-[11px] text-slate-500 mt-0.5\">DNS TXT & ads.txt verify</div>\n                </button>\n\n                <button\n                  onClick={onNavigateToHub}\n                  className=\"p-3.5 rounded-2xl bg-slate-50 hover:bg-slate-100 border border-slate-100 text-left transition-colors group\"\n                >\n                  <Layout className=\"w-4 h-4 text-purple-600 mb-2 group-hover:scale-110 transition-transform\" />\n                  <div className=\"text-xs font-bold text-slate-800\">Branded Game Hub</div>\n                  <div className=\"text-[11px] text-slate-500 mt-0.5\">Custom subdomain portal</div>\n                </button>\n              </div>\n            </div>\n\n            <div className=\"mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500\">\n              <span>Platform Status: <strong className=\"text-emerald-600 font-semibold\">100% Operational</strong></span>\n              <button \n                onClick={onNavigateToAnalytics}\n                className=\"text-blue-600 hover:underline font-semibold flex items-center gap-1\"\n              >\n                <span>Full Analytics</span>\n                <ChevronRight className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n\n      {/* ========================================================================= */}\n      {/* PARTNERS MODAL (TRIGGERED BY SHOW ALL LINK)                               */}\n      {/* ========================================================================= */}\n      {showPartnersModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs\">\n          <div className=\"bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 animate-in fade-in zoom-in-95\">\n            <div className=\"flex items-center justify-between pb-4 border-b border-slate-100\">\n              <div>\n                <h3 className=\"text-base font-bold text-slate-900\">\n                  Syndication Partners & Studios\n                </h3>\n                <p className=\"text-xs text-slate-500\">Active distribution network for DochGames</p>\n              </div>\n              <button \n                onClick={() => setShowPartnersModal(false)}\n                className=\"p-2 text-slate-400 hover:text-slate-600 rounded-full hover:bg-slate-100\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"py-4 space-y-3 max-h-96 overflow-y-auto\">\n              {partnersList.map((partner, i) => (\n                <div key={i} className=\"flex items-center justify-between p-3 rounded-2xl bg-slate-50 hover:bg-slate-100/80 transition-colors\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className={`w-10 h-10 rounded-full ${partner.color} text-white font-bold text-xs flex items-center justify-center shadow-xs`}>\n                      {partner.avatar}\n                    </div>\n                    <div>\n                      <div className=\"text-xs font-bold text-slate-900\">{partner.name}</div>\n                      <div className=\"text-[11px] text-slate-500\">{partner.studio} \302\267 {partner.role}</div>\n                    </div>\n                  </div>\n                  <div className=\"text-right\">\n                    <div className=\"text-xs font-bold text-slate-900\">{partner.monthlyPlays} plays</div>\n                    <div className=\"text-[10px] text-slate-400\">{partner.properties} active properties</div>\n                  </div>\n                </div>\n              ))}\n            </div>\n\n            <div className=\"pt-3 border-t border-slate-100 flex justify-end\">\n              <button\n                onClick={() => setShowPartnersModal(false)}\n                className=\"px-5 py-2 bg-slate-900 text-white rounded-full text-xs font-bold hover:bg-slate-800 transition-colors\"\n              >\n                Close\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n};\n"
    }
