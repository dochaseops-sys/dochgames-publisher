  file_change {
    absolute_path_uri: "file:///src/components/notifications/NotificationCenter.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      {/* Slideover Sheet Panel */}\n      <div \n        className=\"w-full max-w-xl sm:max-w-2xl bg-[#071B4B] border-l border-slate-700 shadow-2xl flex flex-col h-full overflow-hidden text-slate-200\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Header */}\n        <div className=\"p-4 sm:p-5 border-b border-slate-800 bg-[#040f2b]/95 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-9 h-9 rounded-xl bg-[#129BFF]/20 border border-[#129BFF]/40 flex items-center justify-center text-[#11D9FF] shadow-inner\">\n                <Bell className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h2 className=\"font-display font-bold text-lg text-white\">\n                    {viewMode === \'settings\' ? \'Notification & Email Settings\' : \'Platform Notifications & Audits\'}\n                  </h2>\n                  {viewMode === \'stream\' && unreadCount > 0 && (\n                    <span className=\"px-2 py-0.5 rounded-full text-xs font-bold bg-[#129BFF] text-white shadow animate-pulse\">\n                      {unreadCount} new\n                    </span>\n                  )}\n                  {viewMode === \'settings\' && (\n                    <span className={`px-2 py-0.5 rounded-full text-[10px] font-mono font-bold ${\n                      settings.emailAlertsEnabled\n                        ? \'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30\'\n                        : \'bg-slate-700 text-slate-400\'\n                    }`}>\n                      {settings.emailAlertsEnabled ? \'EMAIL ALERTS ON\' : \'EMAIL ALERTS OFF\'}\n                    </span>\n                  )}\n                </div>\n                <p className=\"text-[11px] text-slate-400\">\n                  {viewMode === \'settings\'\n                    ? \'Configure email alerts for critical audits, security violations, and game QA changes.\'\n                    : \'Real-time platform audits, security checks, and partner activity stream.\'}\n                </p>\n              </div>\n            </div>"
      replacement_content: "      {/* Slideover Sheet Panel */}\n      <div \n        className=\"w-full max-w-xl sm:max-w-2xl bg-white border-l border-slate-200 shadow-2xl flex flex-col h-full overflow-hidden text-slate-800\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {/* Header */}\n        <div className=\"p-5 border-b border-slate-100 bg-white space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-10 h-10 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shadow-xs\">\n                <Bell className=\"w-5 h-5 text-[#2563EB]\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-2\">\n                  <h2 className=\"font-extrabold text-base text-slate-900\">\n                    {viewMode === \'settings\' ? \'Notification & Email Settings\' : \'Platform Notifications & Audits\'}\n                  </h2>\n                  {viewMode === \'stream\' && unreadCount > 0 && (\n                    <span className=\"px-2 py-0.5 rounded-full text-xs font-bold bg-[#FF6B2C] text-white shadow-2xs\">\n                      {unreadCount} new\n                    </span>\n                  )}\n                  {viewMode === \'settings\' && (\n                    <span className={`px-2 py-0.5 rounded-full text-[10px] font-mono font-bold ${\n                      settings.emailAlertsEnabled\n                        ? \'bg-emerald-50 text-emerald-700 border border-emerald-200\'\n                        : \'bg-slate-100 text-slate-500\'\n                    }`}>\n                      {settings.emailAlertsEnabled ? \'EMAIL ALERTS ON\' : \'EMAIL ALERTS OFF\'}\n                    </span>\n                  )}\n                </div>\n                <p className=\"text-xs text-slate-500 mt-0.5\">\n                  {viewMode === \'settings\'\n            