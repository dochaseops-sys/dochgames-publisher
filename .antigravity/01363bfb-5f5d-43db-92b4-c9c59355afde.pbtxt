  file_change {
    absolute_path_uri: "file:///src/components/admin/AdminConsole.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Shield, CheckCircle, AlertTriangle, XCircle, Play, \n  Search, Filter, Eye, RefreshCw, MessageSquare, Flame, \n  Activity, Users, Globe, Key, AlertOctagon \n} from \'lucide-react\';\nimport { GameItem, PublisherProperty, UserProfile } from \'../../types\';\nimport { realtime } from \'../../services/websocket\';\nimport { PlayableGameModal } from \'../common/PlayableGameModal\';\n\ninterface AdminConsoleProps {\n  currentUser: UserProfile;\n  games: GameItem[];\n  properties: PublisherProperty[];\n  onUpdateGameStatus: (gameId: string, status: GameItem[\'status\'], reviewNote?: string) => void;\n  onPlayGame: (game: GameItem) => void;\n}\n\nexport const AdminConsole: React.FC<AdminConsoleProps> = ({\n  currentUser,\n  games,\n  properties,\n  onUpdateGameStatus,\n  onPlayGame\n}) => {\n  const [activeTab, setActiveTab] = useState<\'review_queue\' | \'catalogue\' | \'publishers\' | \'system_health\'>(\'review_queue\');\n  const [selectedGame, setSelectedGame] = useState<GameItem | null>(null);\n  const [reviewNoteText, setReviewNoteText] = useState<string>(\'\');\n  const [searchTerm, setSearchTerm] = useState<string>(\'\');\n  const [sandboxModalGame, setSandboxModalGame] = useState<GameItem | null>(null);\n\n  const pendingGames = games.filter(g => g.status === \'submitted\' || g.status === \'in_review\' || g.status === \'changes_required\');\n\n  const handleApprove = (game: GameItem) => {\n    onUpdateGameStatus(game.id, \'live\', reviewNoteText || \'Approved for global DochGames syndication & branded hubs.\');\n    realtime.broadcastNotification(\n      currentUser.name,\n      \'DochGames QA Admin\',\n      \'GAME_APPROVED\',\n      `Game \"${game.title}\" was approved and is now LIVE!`\n    );\n    setSelectedGame(null);\n    setReviewNoteText(\'\');\n  };\n\n  const handleRequestChanges = (game: GameItem) => {\n    if (!reviewNoteText.trim()) {\n      alert(\'Please provide actionable review feedback for the developer before requesting changes.\');\n      return;\n    }\n    onUpdateGameStatus(game.id, \'changes_required\', reviewNoteText);\n    realtime.broadcastNotification(\n      currentUser.name,\n      \'DochGames QA Admin\',\n      \'STATUS_CHANGED\',\n      `Actionable changes requested for \"${game.title}\".`\n    );\n    setSelectedGame(null);\n    setReviewNoteText(\'\');\n  };\n\n  const handleEmergencyDisable = (game: GameItem) => {\n    const newStatus = game.status === \'paused\' ? \'live\' : \'paused\';\n    onUpdateGameStatus(game.id, newStatus, `Admin toggle status to: ${newStatus}`);\n    realtime.broadcastNotification(\n      currentUser.name,\n      \'DochGames QA Admin\',\n      \'STATUS_CHANGED\',\n      `Game \"${game.title}\" marked as ${newStatus.toUpperCase()}`\n    );\n  };\n\n  return (\n    <div className=\"space-y-6 max-w-[1520px] mx-auto\">\n      {/* Top Banner */}\n      <div className=\"bg-white border border-slate-100 p-7 rounded-3xl shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"text-[11px] font-bold text-red-600 uppercase tracking-wider bg-red-50 px-2.5 py-0.5 rounded-full\">\n              Central Operations Console\n            </span>\n            <span className=\"text-slate-400\">\302\267</span>\n            <span className=\"text-xs text-slate-500\">Superadmin Access</span>\n          </div>\n          <h2 className=\"text-2xl font-extrabold text-slate-900 tracking-tight\">\n            DochGames Admin & Moderation Engine\n          </h2>\n          <p className=\"text-slate-500 text-xs mt-1\">\n            Automated pre-flight inspection, sandbox verification, publisher key audits, and emergency take-downs.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-1.5 bg-slate-50 p-1.5 rounded-full border border-slate-200\">\n          {[\n            { id: \'review_queue\', label: `QA Queue (${pendingGames.length})` },\n            { id: \'catalogue\', label: `Catalogue (${games.length})` },\n            { id: \'publishers\', label: `Properties (${properties.length})` },\n            { id: \'system_health\', label: \'Health & CDN\' }\n          ].map(t => (\n            <button\n              key={t.id}\n              onClick={() => setActiveTab(t.id as any)}\n              className={`px-4 py-1.5 rounded-full text-xs font-bold transition-all ${\n                activeTab === t.id ? \'bg-[#2563EB] text-white shadow-xs\' : \'text-slate-600 hover:text-slate-900 hover:bg-white\'\n              }`}\n            >\n              {t.label}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* 1. Review Queue Tab */}\n      {activeTab === \'review_queue\' && (\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n          {/* Left: Pending Games List (6 cols) */}\n          <div className=\"lg:col-span-6 bg-white border border-slate-100 rounded-3xl p-6 shadow-xs space-y-4\">\n            <h3 className=\"font-bold text-base text-slate-900\">\n              Submissions Requiring QA Verification\n            </h3>\n\n            {pendingGames.length === 0 ? (\n              <div className=\"p-8 text-center text-slate-400 text-xs bg-slate-50 rounded-2xl border border-slate-200\">\n                \360\237\216\211 No submissions pending! All developer submissions reviewed.\n              </div>\n            ) : (\n              <div className=\"space-y-3\">\n                {pendingGames.map(game => (\n                  <div\n                    key={game.id}\n                    onClick={() => setSelectedGame(game)}\n                    className={`p-4 rounded-2xl border cursor-pointer transition-all ${\n                      selectedGame?.id === game.id\n                        ? \'bg-blue-50/70 border-blue-500 ring-2 ring-blue-500/20\'\n                        : \'bg-slate-50 border-slate-200 hover:border-slate-300\'\n                    }`}\n                  >\n                    <div className=\"flex items-start gap-3\">\n                      <img\n                        src={game.media.thumbnailUrl}\n                        alt={game.title}\n                        className=\"w-14 h-14 rounded-xl object-cover shrink-0\"\n                      />\n                      <div className=\"flex-1 min-w-0\">\n                        <div className=\"flex items-center justify-between\">\n                          <h4 className=\"font-bold text-sm text-slate-900 truncate\">{game.title}</h4>\n                          <span className=\"text-[10px] uppercase font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full\">\n                            {game.status}\n                          </span>\n                        </div>\n                        <p className=\"text-xs text-slate-500 mt-0.5\">By {game.studioName} \302\267 {game.genre} \302\267 v{game.version}</p>\n                        <div className=\"text-[11px] text-emerald-600 font-semibold mt-1\">\n                          \342\234\223 Automated pre-flight checks: Passed\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            )}\n          </div>\n\n          {/* Right: Inspection & Action Deck (6 cols) */}\n          <div className=\"lg:col-span-6 space-y-4\">\n            {selectedGame ? (\n              <div className=\"bg-white border border-slate-100 rounded-3xl p-6 shadow-xs space-y-5\">\n                <div className=\"flex items-start justify-between\">\n                  <div>\n                    <h3 className=\"font-bold text-lg text-slate-900\">\n                      Inspect: {selectedGame.title}\n                    </h3>\n                    <span className=\"text-xs text-slate-500\">\n                      Studio: {selectedGame.studioName} \302\267 Package: {selectedGame.technical.packageSizeMb} MB\n                    </span>\n                  </div>\n\n                  <button\n                    onClick={() => setSandboxModalGame(selectedGame)}\n                    className=\"flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold transition-colors shadow-xs\"\n                  >\n                    <Play className=\"w-3.5 h-3.5 fill-current\" />\n                    Launch Sandbox Test\n                  </button>\n                </div>\n\n                <div className=\"grid grid-cols-2 gap-3 text-xs bg-slate-50 p-4 rounded-2xl border border-slate-200\">\n                  <div>\n                    <span className=\"text-slate-500 block mb-0.5\">Controls:</span>\n                    <span className=\"text-slate-900 font-bold\">Keyboard, Touch, Gamepad</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 block mb-0.5\">Orientation:</span>\n                    <span className=\"text-slate-900 font-bold uppercase\">{selectedGame.orientation}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 block mb-0.5\">Audio Unlock:</span>\n                    <span className=\"text-emerald-600 font-bold\">Valid (on user gesture)</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 block mb-0.5\">HTTPS Enforced:</span>\n                    <span className=\"text-emerald-600 font-mono font-bold\">TLS 1.3 Valid</span>\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-700 mb-1.5\">\n                    QA Reviewer Feedback Notes (Saved with Version History)\n                  </label>\n                  <textarea\n                    rows={3}\n                    placeholder=\"Enter structured reviewer feedback or reason for approval / changes...\"\n                    value={reviewNoteText}\n                    onChange={(e) => setReviewNoteText(e.target.value)}\n                    className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  />\n                </div>\n\n                <div className=\"flex items-center justify-between gap-3 pt-2\">\n                  <button\n                    onClick={() => handleRequestChanges(selectedGame)}\n                    className=\"flex-1 py-2.5 rounded-full bg-amber-50 border border-amber-300 text-amber-800 text-xs font-bold hover:bg-amber-100 transition-colors\"\n                  >\n                    Request Developer Changes\n                  </button>\n\n                  <button\n                    onClick={() => handleApprove(selectedGame)}\n                    className=\"flex-1 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs transition-all\"\n                  >\n                    Approve & Deploy to Live Feed\n                  </button>\n                </div>\n              </div>\n            ) : (\n              <div className=\"bg-white border border-slate-100 rounded-3xl p-8 text-center text-slate-400 text-xs shadow-xs\">\n                Select a game from the queue on the left to inspect its pre-flight validation status and launch sandbox testing.\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* 2. Global Catalogue Tab */}\n      {activeTab === \'catalogue\' && (\n        <div className=\"bg-white border border-slate-100 rounded-3xl p-6 shadow-xs space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"font-bold text-lg text-slate-900\">\n              Global Syndication Catalogue ({games.length} Titles)\n            </h3>\n            <div className=\"relative w-64\">\n              <input\n                type=\"text\"\n                placeholder=\"Search games...\"\n                value={searchTerm}\n                onChange={(e) => setSearchTerm(e.target.value)}\n                className=\"w-full bg-slate-50 border border-slate-200 rounded-full pl-8 pr-4 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n              />\n              <Search className=\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5\" />\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            {games.filter(g => g.title.toLowerCase().includes(searchTerm.toLowerCase())).map(game => (\n              <div\n                key={game.id}\n                className=\"p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center justify-between gap-4 text-xs\"\n              >\n                <div className=\"flex items-center gap-3\">\n                  <img src={game.media.thumbnailUrl} alt={game.title} className=\"w-10 h-10 rounded-xl object-cover\" />\n                  <div>\n                    <div className=\"font-bold text-slate-900\">{game.title}</div>\n                    <div className=\"text-[11px] text-slate-500\">{game.genre} \302\267 Studio: {game.studioName} \302\267 {game.stats.totalPlays.toLocaleString()} plays</div>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() => onPlayGame(game)}\n                    className=\"px-3 py-1.5 rounded-full bg-blue-50 text-blue-600 font-bold hover:bg-blue-100 transition-colors\"\n                  >\n                    Play\n                  </button>\n\n                  <button\n                    onClick={() => handleEmergencyDisable(game)}\n                    className={`px-3 py-1.5 rounded-full font-bold transition-colors ${\n                      game.status === \'paused\'\n                        ? \'bg-emerald-50 text-emerald-700 border border-emerald-300\'\n                        : \'bg-red-50 text-red-600 border border-red-200 hover:bg-red-100\'\n                    }`}\n                  >\n                    {game.status === \'paused\' ? \'Re-Enable\' : \'Emergency Take-Down\'}\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* 3. Publishers Tab */}\n      {activeTab === \'publishers\' && (\n        <div className=\"bg-white border border-slate-100 rounded-3xl p-6 shadow-xs space-y-4\">\n          <h3 className=\"font-bold text-lg text-slate-900\">\n            Connected Publisher Domains & Security Origin Audits\n          </h3>\n          <div className=\"space-y-3\">\n            {properties.map(p => (\n              <div key={p.id} className=\"p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center justify-between text-xs\">\n                <div>\n                  <div className=\"font-bold text-slate-900 text-sm\">{p.name} ({p.domain})</div>\n                  <div className=\"text-slate-500 font-mono text-[11px] mt-0.5\">Publisher Key: {p.publisherKey}</div>\n                  <div className=\"text-slate-400 text-[11px]\">Allowed Origins: {p.allowedOrigins.join(\', \')}</div>\n                </div>\n                <div className=\"text-right\">\n                  <span className=\"text-[10px] text-emerald-700 font-bold bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full\">\n                    VERIFIED DOMAIN\n                  </span>\n                  <div className=\"text-[11px] text-slate-500 mt-1\">{p.totalWidgets} Active Widgets</div>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* 4. Health & CDN Tab */}\n      {activeTab === \'system_health\' && (\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n          <div className=\"p-6 bg-white border border-slate-100 rounded-3xl shadow-xs space-y-1\">\n            <span className=\"text-xs text-slate-500 font-semibold\">CDN Edge Latency</span>\n            <div className=\"text-2xl font-black text-emerald-600 font-mono\">18ms Global Avg</div>\n            <p className=\"text-[11px] text-slate-400\">Cloudflare & Fastly edge caches warm</p>\n          </div>\n          <div className=\"p-6 bg-white border border-slate-100 rounded-3xl shadow-xs space-y-1\">\n            <span className=\"text-xs text-slate-500 font-semibold\">WebSocket Relay Health</span>\n            <div className=\"text-2xl font-black text-blue-600 font-mono\">100% Operational</div>\n            <p className=\"text-[11px] text-slate-400\">Real-time file sharing relay active</p>\n          </div>\n          <div className=\"p-6 bg-white border border-slate-100 rounded-3xl shadow-xs space-y-1\">\n            <span className=\"text-xs text-slate-500 font-semibold\">Consent & CMP Telemetry</span>\n            <div className=\"text-2xl font-black text-slate-900 font-mono\">0.00% Error Rate</div>\n            <p className=\"text-[11px] text-slate-400\">GDPR & TCF v2.2 compliant signals</p>\n          </div>\n        </div>\n      )}\n\n      {/* Sandbox Modal for Admin Playtesting */}\n      {sandboxModalGame && (\n        <PlayableGameModal\n          game={sandboxModalGame}\n          isOpen={!!sandboxModalGame}\n          onClose={() => setSandboxModalGame(null)}\n        />\n      )}\n    </div>\n  );\n};\n"
    }
