  file_change {
    absolute_path_uri: "file:///src/components/developer/MyGamesPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  Gamepad2, Plus, MessageSquare, CheckCircle, Clock, \n  AlertCircle, Play, Eye, RefreshCw, Filter, Sparkles, Send \n} from \'lucide-react\';\nimport { GameItem, GameReviewStatus, UserProfile } from \'../../types\';\n\ninterface MyGamesPageProps {\n  games: GameItem[];\n  currentUser: UserProfile;\n  onAddNewGame: () => void;\n  onPlayGame: (game: GameItem) => void;\n  onResubmitGame: (gameId: string, note: string) => void;\n}\n\nexport const MyGamesPage: React.FC<MyGamesPageProps> = ({\n  games,\n  currentUser,\n  onAddNewGame,\n  onPlayGame,\n  onResubmitGame\n}) => {\n  const [statusFilter, setStatusFilter] = useState<string>(\'all\');\n  const [activeFeedbackGame, setActiveFeedbackGame] = useState<GameItem | null>(null);\n  const [resubmitMessage, setResubmitMessage] = useState<string>(\'\');\n\n  const filteredGames = games.filter(g => {\n    if (statusFilter === \'all\') return true;\n    return g.status === statusFilter;\n  });\n\n  const getStatusBadge = (status: GameReviewStatus) => {\n    switch (status) {\n      case \'live\':\n        return <span className=\"bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full text-[11px] font-bold\">LIVE</span>;\n      case \'approved\':\n        return <span className=\"bg-blue-50 text-blue-700 border border-blue-200 px-2.5 py-0.5 rounded-full text-[11px] font-bold\">APPROVED</span>;\n      case \'in_review\':\n        return <span className=\"bg-purple-50 text-purple-700 border border-purple-200 px-2.5 py-0.5 rounded-full text-[11px] font-bold\">IN REVIEW</span>;\n      case \'changes_required\':\n        return <span className=\"bg-amber-50 text-amber-700 border border-amber-200 px-2.5 py-0.5 rounded-full text-[11px] font-bold\">CHANGES REQUIRED</span>;\n      case \'submitted\':\n        return <span className=\"bg-slate-100 text-slate-700 border border-slate-200 px-2.5 py-0.5 rounded-full text-[11px] font-bold\">SUBMITTED</span>;\n      default:\n        return <span className=\"bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full text-[11px] font-bold\">{status.toUpperCase()}</span>;\n    }\n  };\n\n  const handleSendResubmit = () => {\n    if (!activeFeedbackGame || !resubmitMessage.trim()) return;\n    onResubmitGame(activeFeedbackGame.id, resubmitMessage.trim());\n    setResubmitMessage(\'\');\n    setActiveFeedbackGame(null);\n  };\n\n  return (\n    <div className=\"space-y-6 max-w-[1520px] mx-auto\">\n      {/* Header */}\n      <div className=\"bg-white border border-slate-100 p-7 rounded-3xl shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"text-[11px] font-bold text-blue-600 uppercase tracking-wider bg-blue-50 px-2.5 py-0.5 rounded-full\">\n              Catalogue Management\n            </span>\n            <span className=\"text-slate-400\">\302\267</span>\n            <span className=\"text-xs text-slate-500\">Live QA Sandbox</span>\n          </div>\n          <h2 className=\"text-2xl font-extrabold text-slate-900 tracking-tight\">\n            Developer Game Portfolio & Review Queue\n          </h2>\n          <p className=\"text-slate-500 text-xs mt-1\">\n            Track status transitions, reviewer QA feedback, live syndication metrics, and resubmissions.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <select\n            value={statusFilter}\n            onChange={(e) => setStatusFilter(e.target.value)}\n            className=\"bg-slate-50 border border-slate-200 rounded-full px-4 py-2 text-xs font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n          >\n            <option value=\"all\">All Statuses ({games.length})</option>\n            <option value=\"live\">Live Titles</option>\n            <option value=\"in_review\">In Review</option>\n            <option value=\"changes_required\">Changes Required</option>\n            <option value=\"submitted\">Submitted</option>\n          </select>\n\n          <button\n            onClick={onAddNewGame}\n            className=\"flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold shadow-xs transition-all\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            Submit New Title\n          </button>\n        </div>\n      </div>\n\n      {/* Portfolio List */}\n      <div className=\"space-y-3\">\n        {filteredGames.map(game => (\n          <div\n            key={game.id}\n            className=\"bg-white border border-slate-100 hover:border-slate-200 rounded-3xl p-6 shadow-xs transition-all duration-150 flex flex-col lg:flex-row lg:items-center justify-between gap-5\"\n          >\n            <div className=\"flex items-start gap-4\">\n              <img\n                src={game.media.thumbnailUrl}\n                alt={game.title}\n                className=\"w-20 h-20 rounded-2xl object-cover shrink-0 border border-slate-100 shadow-2xs\"\n              />\n              <div className=\"space-y-1.5\">\n                <div className=\"flex items-center gap-2 flex-wrap\">\n                  <h3 className=\"font-bold text-base text-slate-900\">\n                    {game.title}\n                  </h3>\n                  {getStatusBadge(game.status)}\n                  <span className=\"text-xs text-slate-300\">\302\267</span>\n                  <span className=\"text-xs text-blue-600 font-mono font-semibold\">v{game.version}</span>\n                  <span className=\"text-xs text-slate-300\">\302\267</span>\n                  <span className=\"text-xs text-slate-600 font-medium\">{game.genre}</span>\n                </div>\n\n                <p className=\"text-xs text-slate-500 line-clamp-1 max-w-xl\">\n                  {game.shortDescription}\n                </p>\n\n                <div className=\"flex items-center gap-3 text-xs text-slate-400 flex-wrap pt-1\">\n                  <span>Studio: <strong className=\"text-slate-700\">{game.studioName}</strong></span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>Plays: <strong className=\"text-slate-900 tabular-nums\">{game.stats.totalPlays.toLocaleString()}</strong></span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>Rating: <strong className=\"text-amber-500\">\342\230\205 {game.stats.rating}</strong></span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>Package: {game.technical.packageSizeMb} MB</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Actions */}\n            <div className=\"flex items-center gap-2 self-end lg:self-center shrink-0\">\n              <button\n                onClick={() => onPlayGame(game)}\n                className=\"flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold transition-colors shadow-xs\"\n              >\n                <Play className=\"w-3.5 h-3.5 fill-current\" />\n                Play Sandbox\n              </button>\n\n              {game.reviewNotes && game.reviewNotes.length > 0 && (\n                <button\n                  onClick={() => setActiveFeedbackGame(game)}\n                  className={`flex items-center gap-1.5 px-3.5 py-2 rounded-full border text-xs font-bold transition-colors ${\n                    game.status === \'changes_required\'\n                      ? \'bg-amber-50 border-amber-300 text-amber-800 hover:bg-amber-100\'\n                      : \'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100\'\n                  }`}\n                >\n                  <MessageSquare className=\"w-3.5 h-3.5\" />\n                  Review Notes ({game.reviewNotes.length})\n                </button>\n              )}\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Review Feedback & Resubmission Modal */}\n      {activeFeedbackGame && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in\">\n          <div className=\"bg-white border border-slate-100 rounded-3xl shadow-2xl w-full max-w-xl overflow-hidden p-7 space-y-4\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <div>\n                <h3 className=\"font-bold text-lg text-slate-900\">\n                  Reviewer Feedback: {activeFeedbackGame.title}\n                </h3>\n                <span className=\"text-xs text-slate-500\">DochGames Submission Version {activeFeedbackGame.version}</span>\n              </div>\n              <button\n                onClick={() => setActiveFeedbackGame(null)}\n                className=\"text-slate-500 hover:text-slate-800 text-xs px-3 py-1.5 rounded-full bg-slate-100 font-semibold\"\n              >\n                Close\n              </button>\n            </div>\n\n            <div className=\"space-y-3 max-h-64 overflow-y-auto pr-1\">\n              {activeFeedbackGame.reviewNotes?.map(rn => (\n                <div key={rn.id} className=\"p-4 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs space-y-1\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-bold text-slate-900\">{rn.author} ({rn.role})</span>\n                    <span className=\"text-[10px] text-slate-400\">\n                      {new Date(rn.timestamp).toLocaleDateString()}\n                    </span>\n                  </div>\n                  <p className=\"text-slate-600 leading-relaxed\">{rn.comment}</p>\n                </div>\n              ))}\n            </div>\n\n            {/* Resubmission Response Box if Changes Required */}\n            {activeFeedbackGame.status === \'changes_required\' && (\n              <div className=\"pt-3 border-t border-slate-100 space-y-2\">\n                <label className=\"block text-xs font-bold text-slate-700\">\n                  Resubmit with Fix Notes\n                </label>\n                <textarea\n                  rows={3}\n                  placeholder=\"Explain fixes applied (e.g. Updated 16:9 cover art, tuned touch drag steering on mobile)...\"\n                  value={resubmitMessage}\n                  onChange={(e) => setResubmitMessage(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                />\n                <button\n                  onClick={handleSendResubmit}\n                  className=\"flex items-center gap-2 px-5 py-2 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold shadow-xs transition-all\"\n                >\n                  <Send className=\"w-3.5 h-3.5\" />\n                  Submit Fixes for QA Approval\n                </button>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
