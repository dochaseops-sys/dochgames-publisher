        replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --canvas-bg: #F0F4F8;\n    --card-bg: #FFFFFF;\n    --brand-blue: #2563EB;\n    --brand-blue-hover: #1D4ED8;\n    --accent-lime: #D4F826;\n    --accent-orange: #FF6B2C;\n    --accent-emerald: #10B981;\n    --text-primary: #0F172A;\n    --text-muted: #64748B;\n    --border-subtle: #E2E8F0;\n  }\n\n  body {\n    font-family: \'Plus Jakarta Sans\', \'Inter\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    background-color: #F0F4F8;\n    color: #0F172A;\n    -webkit-font-smoothing: antialiased;\n  }\n}\n\n.font-display {\n  font-family: \'Plus Jakarta Sans\', \'Fredoka\', \'Inter\', sans-serif;\n}\n\n/* Custom scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #F1F5F9;\n}\n::-webkit-scrollbar-thumb {\n  background: #CBD5E1;\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #94A3B8;\n}\n"
