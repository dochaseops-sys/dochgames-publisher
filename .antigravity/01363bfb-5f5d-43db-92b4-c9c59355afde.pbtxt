      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { \n  Upload, Download, FileCode, FileArchive, FileText, Image as ImageIcon, \n  Trash2, MessageSquare, CheckCircle, ShieldCheck, Clock, Send, \n  ExternalLink, Users, Sparkles, Filter, Search, FileUp, Info, Eye\n} from \'lucide-react\';\nimport { SharedFile, UserProfile } from \'../../types\';\nimport { realtime } from \'../../services/websocket\';\nimport { GigaMascot } from \'../common/GigaMascot\';\n\ninterface FileSharingHubProps {\n  currentUser: UserProfile;\n  onPlayGame?: (gameTitle: string) => void;\n}\n\nexport const FileSharingHub: React.FC<FileSharingHubProps> = ({ currentUser, onPlayGame }) => {\n  const [files, setFiles] = useState<SharedFile[]>([]);\n  const [activeCategory, setActiveCategory] = useState<string>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [isUploading, setIsUploading] = useState<boolean>(false);\n  const [uploadProgress, setUploadProgress] = useState<number>(0);\n  const [selectedFileForComments, setSelectedFileForComments] = useState<SharedFile | null>(null);\n  const [newCommentText, setNewCommentText] = useState<string>(\'\');\n  const [previewFile, setPreviewFile] = useState<SharedFile | null>(null);\n  const [onlineCount, setOnlineCount] = useState<number>(1);\n  const [activeUsers, setActiveUsers] = useState<any[]>([]);\n  const fileInputRef = useRef<HTMLInputElement | null>(null);\n\n  // Form inputs for upload\n  const [uploadCategory, setUploadCategory] = useState<SharedFile[\'category\']>(\'game_build\');\n  const [targetTitle, setTargetTitle] = useState<string>(\'\');\n  const [versionTag, setVersionTag] = useState<string>(\'1.0.0\');\n\n  // Load initial files via REST and listen to WebSockets\n  useEffect(() => {\n    // 1. Fetch initial files via REST\n    fetch(\'/api/files\')\n      .then(res => res.json())\n      .then(data => {\n        if (Array.isArray(data)) {\n          setFiles(data);\n        }\n      })\n      .catch(err => console.warn(\'Could not load files from REST\', err));\n\n    // 2. Register presence on websocket\n    realtime.registerPresence(currentUser);\n\n    // 3. Listen to real-time events\n    const unsubInit = realtime.on(\'init\', (payload) => {\n      if (payload.files) setFiles(payload.files);\n      if (payload.onlineCount) setOnlineCount(payload.onlineCount);\n    });\n\n    const unsubCount = realtime.on(\'presence:count\', (payload) => {\n      if (payload.onlineCount) setOnlineCount(payload.onlineCount);\n    });\n\n    const unsubUsers = realtime.on(\'presence:users\', (payload) => {\n      if (payload.users) setActiveUsers(payload.users);\n    });\n\n    const unsubUploaded = realtime.on(\'file:uploaded\', ({ file }) => {\n      setFiles(prev => {\n        if (prev.some(f => f.id === file.id)) return prev;\n        return [file, ...prev];\n      });\n    });\n\n    const unsubDeleted = realtime.on(\'file:deleted\', ({ fileId }) => {\n      setFiles(prev => prev.filter(f => f.id !== fileId));\n      if (selectedFileForComments?.id === fileId) {\n        setSelectedFileForComments(null);\n      }\n    });\n\n    const unsubComment = realtime.on(\'file:comment_added\', ({ fileId, comment }) => {\n      setFiles(prev => prev.map(f => {\n        if (f.id === fileId) {\n          return {\n            ...f,\n            comments: [...f.comments, comment]\n          };\n        }\n        return f;\n      }));\n\n      setSelectedFileForComments(prev => {\n        if (prev && prev.id === fileId) {\n          return {\n            ...prev,\n            comments: [...prev.comments, comment]\n          };\n        }\n        return prev;\n      });\n    });\n\n    return () => {\n      unsubInit();\n      unsubCount();\n      unsubUsers();\n      unsubUploaded();\n      unsubDeleted();\n      unsubComment();\n    };\n  }, [currentUser]);\n\n  // Handle local simulation or upload\n  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    setIsUploading(true);\n    setUploadProgress(15);\n\n    const progressInterval = setInterval(() => {\n      setUploadProgress(prev => {\n        if (prev >= 90) {\n          clearInterval(progressInterval);\n          return 95;\n        }\n        return prev + 25;\n      });\n    }, 200);\n\n    // Simulate completion and broadcast over WebSocket\n    setTimeout(() => {\n      clearInterval(progressInterval);\n      setUploadProgress(100);\n\n      const newFilePayload: Omit<SharedFile, \'id\' | \'checksum\' | \'uploadedAt\' | \'comments\'> = {\n        name: file.name,\n        category: uploadCategory,\n        size: file.size,\n        uploadedBy: {\n          name: currentUser.name,\n          role: currentUser.role === \'publisher\' ? \'Publisher Partner\' : currentUser.role === \'developer\' ? \'Game Developer\' : \'DochGames Admin\',\n          company: currentUser.companyOrStudio\n        },\n        version: versionTag || \'1.0.0\',\n        targetGameOrWidget: targetTitle || \'DochGames Platform\'\n      };\n\n      realtime.shareFile(newFilePayload);\n\n      setIsUploading(false);\n      setUploadProgress(0);\n      if (fileInputRef.current) fileInputRef.current.value = \'\';\n    }, 1200);\n  };\n\n  const handleDeleteFile = (fileId: string) => {\n    realtime.deleteFile(fileId);\n  };\n\n  const handleSendComment = () => {\n    if (!selectedFileForComments || !newCommentText.trim()) return;\n\n    realtime.addFileComment(\n      selectedFileForComments.id,\n      currentUser.name,\n      currentUser.role === \'publisher\' ? \'Publisher\' : currentUser.role === \'developer\' ? \'Developer\' : \'DochGames Admin\',\n      newCommentText.trim()\n    );\n\n    setNewCommentText(\'\');\n  };\n\n  const filteredFiles = files.filter(f => {\n    const matchesCategory = activeCategory === \'all\' || f.category === activeCategory;\n    const matchesQuery = \n      f.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      f.uploadedBy.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (f.targetGameOrWidget && f.targetGameOrWidget.toLowerCase().includes(searchQuery.toLowerCase()));\n    return matchesCategory && matchesQuery;\n  });\n\n  const getCategoryIcon = (category: SharedFile[\'category\']) => {\n    switch (category) {\n      case \'game_build\':\n        return <FileArchive className=\"w-5 h-5 text-blue-600\" />;\n      case \'asset_pack\':\n        return <ImageIcon className=\"w-5 h-5 text-emerald-600\" />;\n      case \'sdk_package\':\n        return <FileCode className=\"w-5 h-5 text-purple-600\" />;\n      case \'doc_spec\':\n        return <FileText className=\"w-5 h-5 text-amber-600\" />;\n      default:\n        return <FileArchive className=\"w-5 h-5 text-slate-500\" />;\n    }\n  };\n\n  const formatFileSize = (bytes: number) => {\n    if (bytes >= 1048576) return (bytes / 1048576).toFixed(1) + \' MB\';\n    if (bytes >= 1024) return (bytes / 1024).toFixed(0) + \' KB\';\n    return bytes + \' B\';\n  };\n\n  return (\n    <div className=\"space-y-6 max-w-[1520px] mx-auto\">\n      {/* Top Banner & Real-Time Presence Header */}\n      <div className=\"bg-white border border-slate-100 rounded-3xl p-7 shadow-xs relative overflow-hidden\">\n        <div className=\"flex flex-col lg:flex-row lg:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center gap-2 mb-1\">\n              <span className=\"flex h-2.5 w-2.5 relative\">\n                <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n                <span className=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500\"></span>\n              </span>\n              <span className=\"text-[11px] font-bold text-emerald-700 uppercase tracking-wider bg-emerald-50 px-2.5 py-0.5 rounded-full\">\n                WebSocket Mesh Active\n              </span>\n            </div>\n            <h2 className=\"text-2xl font-extrabold text-slate-900 tracking-tight\">\n              Real-Time File & Build Distribution Network\n            </h2>\n            <p className=\"text-slate-500 text-xs mt-1 max-w-2xl\">\n              Instant peer-to-peer asset delivery between Game Developers, Publishers, and DochGames QA. Upload game builds (.zip), asset packs, and integration SDKs with real-time sync and SHA-256 integrity checks.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <div className=\"bg-slate-50 px-4 py-2 rounded-full border border-slate-200 flex items-center gap-2.5 text-xs\">\n              <Users className=\"w-4 h-4 text-blue-600\" />\n              <div>\n                <span className=\"text-slate-500\">Connected Peers: </span>\n                <strong className=\"text-slate-900 font-bold\">{onlineCount} online</strong>\n              </div>\n            </div>\n\n            <button\n              onClick={() => fileInputRef.current?.click()}\n              className=\"flex items-center gap-2 px-6 py-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold shadow-xs transition-all\"\n            >\n              <FileUp className=\"w-4 h-4\" />\n              Upload & Share File\n            </button>\n            <input\n              type=\"file\"\n              ref={fileInputRef}\n              onChange={handleFileSelect}\n              className=\"hidden\"\n            />\n          </div>\n        </div>\n\n        {/* Upload Drawer / Settings */}\n        <div className=\"mt-5 pt-5 border-t border-slate-100 grid grid-cols-1 md:grid-cols-3 gap-4 text-xs\">\n          <div>\n            <label className=\"text-slate-700 font-bold block mb-1.5\">Target Classification</label>\n            <select\n              value={uploadCategory}\n              onChange={(e) => setUploadCategory(e.target.value as any)}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            >\n              <option value=\"game_build\">Game Build (.zip / HTML5 bundle)</option>\n              <option value=\"asset_pack\">High-Res Asset Pack (.zip / PNG / SVG)</option>\n              <option value=\"sdk_package\">Widget SDK / Code Extension (.js / .ts)</option>\n              <option value=\"doc_spec\">Technical Specification (.pdf / .md)</option>\n            </select>\n          </div>\n\n          <div>\n            <label className=\"text-slate-700 font-bold block mb-1.5\">Associated Game or Widget</label>\n            <input\n              type=\"text\"\n              placeholder=\"e.g. Cyber Neon Racer or Homepage Slit Reel\"\n              value={targetTitle}\n              onChange={(e) => setTargetTitle(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n          </div>\n\n          <div>\n            <label className=\"text-slate-700 font-bold block mb-1.5\">Build Version Tag</label>\n            <input\n              type=\"text\"\n              placeholder=\"e.g. 1.4.2\"\n              value={versionTag}\n              onChange={(e) => setVersionTag(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n            />\n          </div>\n        </div>\n\n        {/* Upload Progress Indicator */}\n        {isUploading && (\n          <div className=\"mt-4 p-4 bg-blue-50 border border-blue-200 rounded-2xl animate-in fade-in\">\n            <div className=\"flex items-center justify-between text-xs text-blue-900 font-bold mb-1.5\">\n              <span className=\"flex items-center gap-2\">\n                <Upload className=\"w-3.5 h-3.5 text-blue-600 animate-bounce\" />\n                Broadcasting file across WebSocket mesh...\n              </span>\n              <span className=\"font-mono text-blue-600 font-bold\">{uploadProgress}%</span>\n            </div>\n            <div className=\"w-full bg-blue-200/50 rounded-full h-2 overflow-hidden\">\n              <div \n                className=\"bg-[#2563EB] h-2 transition-all duration-150 rounded-full\" \n                style={{ width: `${uploadProgress}%` }}\n              />\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Filter and Search Bar */}\n      <div className=\"flex flex-col sm:flex-row items-center justify-between gap-4\">\n        {/* Category Segmented Buttons */}\n        <div className=\"flex items-center gap-1.5 p-1 bg-white border border-slate-100 rounded-full overflow-x-auto w-full sm:w-auto shadow-xs\">\n          {[\n            { id: \'all\', label: \'All Files\' },\n            { id: \'game_build\', label: \'Game Builds\' },\n            { id: \'asset_pack\', label: \'Asset Packs\' },\n            { id: \'sdk_package\', label: \'SDKs\' },\n            { id: \'doc_spec\', label: \'Specs\' }\n          ].map(tab => (\n            <button\n              key={tab.id}\n              onClick={() => setActiveCategory(tab.id)}\n              className={`px-4 py-1.5 text-xs font-bold rounded-full transition-all whitespace-nowrap ${\n                activeCategory === tab.id\n                  ? \'bg-[#2563EB] text-white shadow-xs\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n              }`}\n            >\n              {tab.label}\n            </button>\n          ))}\n        </div>\n\n        {/* Search */}\n        <div className=\"relative w-full sm:w-72\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-2.5\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search files, games, authors...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full bg-white border border-slate-200 rounded-full pl-9 pr-4 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-xs\"\n          />\n        </div>\n      </div>\n\n      {/* Main Files Table / Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"lg:col-span-2 space-y-3\">\n          {filteredFiles.length === 0 ? (\n            <div className=\"bg-white border border-slate-100 rounded-3xl p-10 text-center flex flex-col items-center shadow-xs\">\n              <GigaMascot mood=\"thinking\" size=\"md\" className=\"mb-4\" />\n              <h4 className=\"text-lg font-bold text-slate-900 mb-1\">No shared files found</h4>\n              <p className=\"text-slate-500 text-xs max-w-sm mb-4\">\n                Upload a game build package (.zip) or marketing asset pack to share with publishers and admins in real-time.\n              </p>\n              <button\n                onClick={() => fileInputRef.current?.click()}\n                className=\"px-5 py-2 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white text-xs font-bold transition-colors shadow-xs\"\n              >\n                Upload First File\n              </button>\n            </div>\n          ) : (\n            filteredFiles.map(file => (\n              <div\n                key={file.id}\n                className=\"bg-white border border-slate-100 hover:border-slate-200 rounded-3xl p-5 transition-all duration-150 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4\"\n              >\n                <div className=\"flex items-start gap-3.5\">\n                  <div className=\"p-3 bg-slate-50 border border-slate-100 rounded-2xl shrink-0\">\n                    {getCategoryIcon(file.category)}\n                  </div>\n                  <div>\n                    <div className=\"flex items-center gap-2 flex-wrap\">\n                      <h4 className=\"text-sm font-bold text-slate-900 hover:text-blue-600 cursor-pointer transition-colors\">\n                        {file.name}\n                      </h4>\n                      {file.version && (\n                        <span className=\"text-xs text-slate-400 font-mono\">v{file.version}</span>\n                      )}\n                      <span className=\"text-xs text-slate-300\">\302\267</span>\n                      <span className=\"text-xs text-slate-500\">{formatFileSize(file.size)}</span>\n                      <span className=\"text-xs text-slate-300\">\302\267</span>\n                      <span className=\"inline-flex items-center gap-1 text-[11px] text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded-full\">\n                        <ShieldCheck className=\"w-3 h-3 text-emerald-600\" />\n                        Clean\n                      </span>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 mt-1.5 text-xs text-slate-500 flex-wrap\">\n                      <span>Target: <strong className=\"text-slate-700 font-semibold\">{file.targetGameOrWidget || \'General\'}</strong></span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>By: <span className=\"text-slate-700 font-medium\">{file.uploadedBy.name}</span> ({file.uploadedBy.role})</span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>{new Date(file.uploadedAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}</span>\n                    </div>\n\n                    {/* SHA256 snippet */}\n                    <div className=\"mt-1 text-[11px] font-mono text-slate-400 truncate max-w-md\">\n                      Hash: {file.checksum}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Right action buttons */}\n                <div className=\"flex items-center gap-2 self-end sm:self-center shrink-0\">\n                  <button\n                    onClick={() => setSelectedFileForComments(file)}\n                    className=\"flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-slate-50 border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-100 transition-colors\"\n                  >\n                    <MessageSquare className=\"w-3.5 h-3.5 text-blue-600\" />\n                    <span>{file.comments.length}</span>\n                  </button>\n\n                  <a\n                    href={`data:text/plain;charset=utf-8,${encodeURIComponent(file.name + \' - DochGames Verified Package\')}`}\n                    download={file.name}\n                    className=\"flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-blue-50 text-blue-600 text-xs font-bold hover:bg-blue-100 transition-colors\"\n                  >\n                    <Download className=\"w-3.5 h-3.5\" />\n                    <span>Download</span>\n                  </a>\n\n                  {(currentUser.role === \'DochGames Admin\' || currentUser.name === file.uploadedBy.name) && (\n                    <button\n                      onClick={() => handleDeleteFile(file.id)}\n                      title=\"Delete file\"\n                      className=\"p-2 rounded-full text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors\"\n                    >\n                      <Trash2 className=\"w-3.5 h-3.5\" />\n                    </button>\n                  )}\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n\n        {/* Right Column: File Review & Real-Time Collaboration Thread */}\n        <div className=\"bg-white border border-slate-100 rounded-3xl p-6 shadow-xs flex flex-col h-[560px]\">\n          <div className=\"border-b border-slate-100 pb-3.5 mb-3\">\n            <h3 className=\"font-bold text-slate-900 text-base flex items-center gap-2\">\n              <MessageSquare className=\"w-4 h-4 text-blue-600\" />\n              Real-Time Build Feedback\n            </h3>\n            <p className=\"text-slate-500 text-xs mt-0.5 truncate\">\n              {selectedFileForComments \n                ? `Discussing: ${selectedFileForComments.name}`\n                : \'Select a file to view notes and reviewer comments\'}\n            </p>\n          </div>\n\n          {selectedFileForComments ? (\n            <>\n              {/* Comments stream */}\n              <div className=\"flex-1 overflow-y-auto space-y-3 pr-1 text-xs\">\n                {selectedFileForComments.comments.length === 0 ? (\n                  <div className=\"h-full flex flex-col items-center justify-center text-center p-4 text-slate-400\">\n                    <p>No feedback yet on this build package.</p>\n                    <p className=\"text-[11px] text-slate-400 mt-1\">Leave a verification note or QA comment below.</p>\n                  </div>\n                ) : (\n                  selectedFileForComments.comments.map(c => (\n                    <div \n                      key={c.id} \n                      className={`p-3.5 rounded-2xl border ${\n                        c.role === \'DochGames Admin\' \n                          ? \'bg-blue-50/70 border-blue-200\' \n                          : \'bg-slate-50 border-slate-200/80\'\n                      }`}\n                    >\n                      <div className=\"flex items-center justify-between mb-1\">\n                        <span className=\"font-bold text-slate-900\">\n                          {c.author}\n                          <span className=\"ml-1.5 text-[10px] font-bold text-blue-600\">\n                            [{c.role}]\n                          </span>\n                        </span>\n                        <span className=\"text-[10px] text-slate-400\">\n                          {new Date(c.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n                        </span>\n                      </div>\n                      <p className=\"text-slate-600 leading-relaxed\">{c.message}</p>\n                    </div>\n                  ))\n                )}\n              </div>\n\n              {/* Add comment input */}\n              <div className=\"pt-3 border-t border-slate-100 mt-2\">\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"text\"\n                    placeholder=\"Write a QA note or publisher question...\"\n                    value={newCommentText}\n                    onChange={(e) => setNewCommentText(e.target.value)}\n                    onKeyDown={(e) => e.key === \'Enter\' && handleSendComment()}\n                    className=\"flex-1 bg-slate-50 border border-slate-200 rounded-full px-4 py-2 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500\"\n                  />\n                  <button\n                    onClick={handleSendComment}\n                    className=\"p-2.5 rounded-full bg-[#2563EB] hover:bg-[#1D4ED8] text-white transition-colors shadow-xs\"\n                  >\n                    <Send className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            </>\n          ) : (\n            <div className=\"flex-1 flex flex-col items-center justify-center text-center p-6\">\n              <GigaMascot mood=\"helpful\" size=\"sm\" className=\"mb-3\" />\n              <p className=\"text-slate-800 text-xs font-bold\">Select a shared build or asset</p>\n              <p className=\"text-slate-400 text-[11px] mt-1\">\n                Click the comment icon on any file to inspect real-time QA validation notes, publisher feedback, or bug reports.\n              </p>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
